#!/bin/sh

# Read POST body if query string is empty
if [ "$REQUEST_METHOD" = "POST" ] && [ -z "$QUERY_STRING" ]; then
    read -r QUERY_STRING
fi

urldecode() {
    # Safe percent-decoding using awk to avoid printf format string expansion issues
    echo -n "$1" | awk '
    BEGIN {
        for (i = 0; i < 256; i++) {
            c = sprintf("%c", i);
            hex = sprintf("%02X", i);
            map[hex] = c;
            map[tolower(hex)] = c;
        }
    }
    {
        gsub(/\+/, " ");
        len = length($0);
        res = "";
        for (i = 1; i <= len; i++) {
            ch = substr($0, i, 1);
            if (ch == "%" && i + 2 <= len) {
                h = substr($0, i + 1, 2);
                if (h in map) {
                    res = res map[h];
                    i += 2;
                    continue;
                }
            }
            res = res ch;
        }
        print res;
    }' 2>/dev/null
}

get_param() {
    echo "$QUERY_STRING" | tr "&" "\n" | grep "^$1=" | head -n1 | cut -d"=" -f2-
}

get_cookie() {
    echo "$HTTP_COOKIE" | tr ";" "\n" | grep -i "^[ ]*$1=" | head -n1 | cut -d"=" -f2- | tr -d " \r\n"
}

ACTION=$(get_param action)
CMD=$(echo "$QUERY_STRING" | cut -d"=" -f1 | tr -cd "a-zA-Z0-9_")
VAL=$(echo "$QUERY_STRING" | cut -d"=" -f2 | tr -cd "a-zA-Z0-9_")

if [ -n "$ACTION" ]; then
    CMD=$(echo "$ACTION" | tr -cd "a-zA-Z0-9_")
fi

# Handle Artwork endpoint directly (Binary image output)
if [ "$CMD" = "get_artwork" ] || [ "$ACTION" = "get_artwork" ]; then
    ARTWORK_FILE="/tmp/audiopro_artwork.jpg"
    if [ -f "$ARTWORK_FILE" ] && [ -s "$ARTWORK_FILE" ]; then
        echo "Content-Type: image/jpeg"
        echo "Cache-Control: no-cache, no-store, must-revalidate"
        echo ""
        cat "$ARTWORK_FILE"
        exit 0
    else
        echo "Status: 404 Not Found"
        echo "Content-Type: text/plain"
        echo ""
        echo "No artwork available"
        exit 0
    fi
fi

# Authentication Verification
AUTH_CONF="/etc/audiopro_auth"
AUTH_ENABLED=0
if [ -f "$AUTH_CONF" ]; then
    . "$AUTH_CONF" 2>/dev/null || true
fi

if [ "$AUTH_ENABLED" = "1" ]; then
    TOKEN=$(get_cookie ap_sid | tr -cd "a-f0-9")
    SESS_FILE="/tmp/ap_sessions/$TOKEN"
    NOW=$(date +%s)
    UA="${HTTP_USER_AGENT:-unknown}"
    IP="${REMOTE_ADDR:-127.0.0.1}"
    CUR_FP=$(echo -n "${IP}|${UA}" | md5sum | cut -d" " -f1)
    
    IS_VALID=0
    if [ -n "$TOKEN" ] && [ -f "$SESS_FILE" ]; then
        S_EXP=$(grep "^expires=" "$SESS_FILE" 2>/dev/null | cut -d"=" -f2-)
        S_FP=$(grep "^fingerprint=" "$SESS_FILE" 2>/dev/null | cut -d"=" -f2-)
        if [ -n "$S_EXP" ] && [ "$NOW" -lt "$S_EXP" ] && [ "$S_FP" = "$CUR_FP" ]; then
            IS_VALID=1
        fi
    fi
    
    if [ "$IS_VALID" != "1" ]; then
        echo "Status: 403 Forbidden"
        echo "Content-Type: application/json"
        echo ""
        echo "{\"status\":\"error\",\"code\":403,\"message\":\"Forbidden: Authentication required\"}"
        exit 0
    fi
fi

echo "Content-Type: application/json"
echo ""

send_mcu() {
    if [ -p /tmp/mcu_cmd_fifo ] && [ -w /tmp/mcu_cmd_fifo ]; then
        echo -ne "$1" > /tmp/mcu_cmd_fifo 2>/dev/null || true
    elif [ -w /dev/ttyS0 ]; then
        echo -ne "$1" > /dev/ttyS0 2>/dev/null || true
    fi
}

case "$CMD" in
    volume)
        VOL=$(printf "%d" "$VAL" 2>/dev/null || echo 50)
        [ "$VOL" -lt 0 ] && VOL=0
        [ "$VOL" -gt 100 ] && VOL=100
        send_mcu "AXX+VOL+$(printf "%03d" $VOL)\n"
        echo "$VOL" > /tmp/current_volume 2>/dev/null
        echo "{\"status\":\"ok\",\"volume\":$VOL}"
        ;;
    mute)
        send_mcu "AXX+MUT+001\n"
        echo "1" > /tmp/current_mute 2>/dev/null
        echo "{\"status\":\"ok\",\"mute\":true}"
        ;;
    unmute)
        send_mcu "AXX+MUT+000\n"
        echo "0" > /tmp/current_mute 2>/dev/null
        echo "{\"status\":\"ok\",\"mute\":false}"
        ;;
    input)
        case "$VAL" in
            wifi|i2s)
                send_mcu "AXX+INP+000\n"
                send_mcu "AXX+PLM+001\n"
                send_mcu "AXX+MUT+000\n"
                echo "wifi" > /tmp/audio_source 2>/dev/null
                ;;
            bt|bluetooth)
                send_mcu "AXX+INP+002\n"
                echo "bluetooth" > /tmp/audio_source 2>/dev/null
                ;;
            aux)
                send_mcu "AXX+INP+001\n"
                echo "aux" > /tmp/audio_source 2>/dev/null
                ;;
        esac
        echo "{\"status\":\"ok\",\"input\":\"$VAL\"}"
        ;;
    status)
        BAT=$(cat /tmp/battery_status 2>/dev/null | grep -o "[0-9]*" | head -n1)
        [ -z "$BAT" ] && BAT=100
        SRC=$(cat /tmp/audio_source 2>/dev/null || echo "wifi")
        VOL=$(cat /tmp/current_volume 2>/dev/null || echo "25")
        MUT=$(cat /tmp/current_mute 2>/dev/null || echo "0")
        [ "$MUT" = "1" ] && MUT_JSON="true" || MUT_JSON="false"
        
        STA_SSID=$(uci -q get wireless.sta_iface.ssid 2>/dev/null || echo "")
        STA_DIS=$(uci -q get wireless.sta_iface.disabled 2>/dev/null || echo "1")
        AP_SSID=$(uci -q get wireless.ap_iface.ssid 2>/dev/null || echo "AudioPro-C3-Setup")
        HOSTNAME=$(uci -q get system.@system[0].hostname 2>/dev/null || echo "AudioPro-C3")
        
        IP_ADDR=$(ip -4 -o addr show dev wwan 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
        [ -z "$IP_ADDR" ] && IP_ADDR=$(ip -4 -o addr show dev br-lan 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
        [ -z "$IP_ADDR" ] && IP_ADDR=$(ip -4 -o addr show dev eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
        [ -z "$IP_ADDR" ] && IP_ADDR="10.10.10.254"

        STA_CONN="false"
        if [ "$STA_DIS" = "0" ] && [ -n "$STA_SSID" ]; then
            if ip -4 -o addr show dev wwan 2>/dev/null | grep -q "inet"; then
                STA_CONN="true"
            fi
        fi

        UPTIME_SEC=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 120)
        LOADAVG=$(awk '{print $1}' /proc/loadavg 2>/dev/null || echo "0.15")
        MEM_FREE=$(awk '/MemAvailable/ {printf "%.1f", $2/1024}' /proc/meminfo 2>/dev/null || awk '/MemFree/ {printf "%.1f", $2/1024}' /proc/meminfo 2>/dev/null || echo "32.0")

        AIRPLAY_ACT="false"
        pidof shairport-sync >/dev/null 2>&1 && AIRPLAY_ACT="true"
        SPOTIFY_ACT="false"
        pidof librespot >/dev/null 2>&1 && SPOTIFY_ACT="true"

        NOW_PLAYING_JSON="{\"active\":false}"
        META_JSON="/tmp/audiopro_meta.json"
        if [ -f "$META_JSON" ] && [ -s "$META_JSON" ]; then
            NOW_PLAYING_JSON=$(cat "$META_JSON" 2>/dev/null || echo "{\"active\":false}")
        fi

        echo "{\"status\":\"ok\",\"battery\":$BAT,\"source\":\"$SRC\",\"volume\":$VOL,\"mute\":$MUT_JSON,\"ip\":\"$IP_ADDR\",\"sta_ssid\":\"$STA_SSID\",\"sta_connected\":$STA_CONN,\"ap_ssid\":\"$AP_SSID\",\"hostname\":\"$HOSTNAME\",\"uptime\":$UPTIME_SEC,\"load\":\"$LOADAVG\",\"mem_free\":\"$MEM_FREE MB\",\"airplay\":$AIRPLAY_ACT,\"spotify\":$SPOTIFY_ACT,\"now_playing\":$NOW_PLAYING_JSON}"
        ;;
    get_config)
        AP_SSID=$(uci -q get wireless.ap_iface.ssid 2>/dev/null || echo "AudioPro-C3-Setup")
        AP_KEY=$(uci -q get wireless.ap_iface.key 2>/dev/null || echo "setup12345")
        AP_CHAN=$(uci -q get wireless.radio0.channel 2>/dev/null || echo "auto")
        AP_DIS=$(uci -q get wireless.ap_iface.disabled 2>/dev/null || echo "0")
        [ "$AP_DIS" = "1" ] && AP_DIS_JSON="true" || AP_DIS_JSON="false"

        STA_SSID=$(uci -q get wireless.sta_iface.ssid 2>/dev/null || echo "")
        STA_KEY=$(uci -q get wireless.sta_iface.key 2>/dev/null || echo "")
        STA_DIS=$(uci -q get wireless.sta_iface.disabled 2>/dev/null || echo "1")
        [ "$STA_DIS" = "1" ] && STA_DIS_JSON="true" || STA_DIS_JSON="false"

        DEF_VOL=$(uci -q get mcud.main.default_volume 2>/dev/null || echo "25")
        AUTO_SLEEP=$(uci -q get mcud.main.auto_sleep_min 2>/dev/null || echo "0")
        SLP_AUX=$(uci -q get mcud.main.sleep_in_aux 2>/dev/null || echo "0")
        [ "$SLP_AUX" = "1" ] && SLP_AUX_JSON="true" || SLP_AUX_JSON="false"
        SLP_BT=$(uci -q get mcud.main.sleep_in_bt 2>/dev/null || echo "0")
        [ "$SLP_BT" = "1" ] && SLP_BT_JSON="true" || SLP_BT_JSON="false"

        MQTT_EN=$(uci -q get mcud.main.mqtt_enabled 2>/dev/null || echo "1")
        [ "$MQTT_EN" = "1" ] && MQTT_EN_JSON="true" || MQTT_EN_JSON="false"
        MQTT_HOST=$(uci -q get mcud.main.mqtt_host 2>/dev/null || echo "127.0.0.1")
        MQTT_PORT=$(uci -q get mcud.main.mqtt_port 2>/dev/null || echo "1883")
        MQTT_PRE=$(uci -q get mcud.main.mqtt_topic_prefix 2>/dev/null || echo "audiopro_c3")
        MQTT_USER=$(uci -q get mcud.main.mqtt_user 2>/dev/null || echo "")

        HOSTNAME=$(uci -q get system.@system[0].hostname 2>/dev/null || echo "AudioPro-C3")

        echo "{\"status\":\"ok\",\"ap_ssid\":\"$AP_SSID\",\"ap_key\":\"$AP_KEY\",\"ap_channel\":\"$AP_CHAN\",\"ap_disabled\":$AP_DIS_JSON,\"sta_ssid\":\"$STA_SSID\",\"sta_key\":\"$STA_KEY\",\"sta_disabled\":$STA_DIS_JSON,\"default_volume\":$DEF_VOL,\"auto_sleep_min\":$AUTO_SLEEP,\"sleep_in_aux\":$SLP_AUX_JSON,\"sleep_in_bt\":$SLP_BT_JSON,\"mqtt_enabled\":$MQTT_EN_JSON,\"mqtt_host\":\"$MQTT_HOST\",\"mqtt_port\":$MQTT_PORT,\"mqtt_prefix\":\"$MQTT_PRE\",\"mqtt_user\":\"$MQTT_USER\",\"hostname\":\"$HOSTNAME\"}"
        ;;
    get_security)
        AUTH_EN=0
        S_TTL=604800
        [ -f /etc/audiopro_auth ] && . /etc/audiopro_auth 2>/dev/null
        S_DAYS=$((S_TTL / 86400))
        echo "{\"status\":\"ok\",\"auth_enabled\":$AUTH_EN,\"session_ttl\":$S_TTL,\"session_days\":$S_DAYS}"
        ;;
    save_security)
        AUTH_EN_RAW=$(get_param auth_enabled)
        SESS_DAYS_RAW=$(get_param session_days)
        
        AUTH_EN=0
        [ "$AUTH_EN_RAW" = "1" ] || [ "$AUTH_EN_RAW" = "true" ] && AUTH_EN=1
        
        SESS_DAYS=$(printf "%d" "$SESS_DAYS_RAW" 2>/dev/null || echo 7)
        [ "$SESS_DAYS" -lt 1 ] && SESS_DAYS=1
        [ "$SESS_DAYS" -gt 365 ] && SESS_DAYS=365
        SESS_TTL=$((SESS_DAYS * 86400))
        
        cat << SEC_EOF > /etc/audiopro_auth
AUTH_ENABLED=$AUTH_EN
SESSION_TTL=$SESS_TTL
SEC_EOF
        echo "{\"status\":\"ok\",\"message\":\"Security settings saved\",\"auth_enabled\":$AUTH_EN,\"session_ttl\":$SESS_TTL,\"session_days\":$SESS_DAYS}"
        ;;
    save_ap)
        AP_SSID_RAW=$(get_param ap_ssid)
        AP_KEY_RAW=$(get_param ap_key)
        AP_CHAN_RAW=$(get_param ap_channel)
        AP_DIS_RAW=$(get_param ap_disabled)

        AP_SSID=$(urldecode "$AP_SSID_RAW" | tr -cd "[:alnum:] _.,@#%+=/()[]!?-")
        AP_KEY=$(urldecode "$AP_KEY_RAW" | tr -cd "[:alnum:] _.,@#%+=/()[]!?-")
        AP_CHAN=$(urldecode "$AP_CHAN_RAW" | tr -cd "[:alnum:]")

        if [ -n "$AP_SSID" ]; then
            uci set wireless.ap_iface.ssid="$AP_SSID" 2>/dev/null
        fi
        if [ -n "$AP_KEY" ]; then
            if [ ${#AP_KEY} -ge 8 ]; then
                uci set wireless.ap_iface.encryption="psk2" 2>/dev/null
                uci set wireless.ap_iface.key="$AP_KEY" 2>/dev/null
            else
                echo "{\"status\":\"error\",\"message\":\"AP password must be at least 8 characters\"}"
                exit 0
            fi
        else
            uci set wireless.ap_iface.encryption="none" 2>/dev/null
            uci -q del wireless.ap_iface.key 2>/dev/null
        fi
        if [ -n "$AP_CHAN" ]; then
            uci set wireless.radio0.channel="$AP_CHAN" 2>/dev/null
        fi
        if [ "$AP_DIS_RAW" = "1" ] || [ "$AP_DIS_RAW" = "true" ]; then
            uci set wireless.ap_iface.disabled="1" 2>/dev/null
        else
            uci set wireless.ap_iface.disabled="0" 2>/dev/null
        fi
        uci commit wireless 2>/dev/null
        (sleep 1 && wifi reload) >/dev/null 2>&1 &
        echo "{\"status\":\"ok\",\"message\":\"AP settings applied\"}"
        ;;
    save_audio)
        DEF_VOL_RAW=$(get_param default_volume)
        AUTO_SLP_RAW=$(get_param auto_sleep_min)
        SLP_AUX_RAW=$(get_param sleep_in_aux)
        SLP_BT_RAW=$(get_param sleep_in_bt)

        DEF_VOL=$(printf "%d" "$DEF_VOL_RAW" 2>/dev/null || echo 25)
        AUTO_SLP=$(printf "%d" "$AUTO_SLP_RAW" 2>/dev/null || echo 0)

        uci set mcud.main.default_volume="$DEF_VOL" 2>/dev/null
        uci set mcud.main.auto_sleep_min="$AUTO_SLP" 2>/dev/null

        [ "$SLP_AUX_RAW" = "1" ] || [ "$SLP_AUX_RAW" = "true" ] && uci set mcud.main.sleep_in_aux="1" 2>/dev/null || uci set mcud.main.sleep_in_aux="0" 2>/dev/null
        [ "$SLP_BT_RAW" = "1" ] || [ "$SLP_BT_RAW" = "true" ] && uci set mcud.main.sleep_in_bt="1" 2>/dev/null || uci set mcud.main.sleep_in_bt="0" 2>/dev/null

        uci commit mcud 2>/dev/null
        /etc/init.d/mcud restart >/dev/null 2>&1 &
        echo "{\"status\":\"ok\",\"message\":\"Audio & Power settings saved\"}"
        ;;
    save_device)
        HOST_RAW=$(get_param hostname)
        HOST=$(urldecode "$HOST_RAW" | tr -cd "[:alnum:]-" | tr "[:upper:]" "[:lower:]")
        
        if [ -n "$HOST" ]; then
            uci set system.@system[0].hostname="$HOST" 2>/dev/null
            uci commit system 2>/dev/null
            echo "$HOST" > /proc/sys/kernel/hostname 2>/dev/null || true
            sed -i "s/name = .*/name = \"$HOST\";/" /etc/shairport-sync.conf 2>/dev/null || true
            uci set shairport-sync.shairport_sync.name="$HOST" 2>/dev/null || true
            uci commit shairport-sync 2>/dev/null || true
            echo "{\"status\":\"ok\",\"message\":\"Device name updated to $HOST\"}"
        else
            echo "{\"status\":\"error\",\"message\":\"Hostname cannot be empty\"}"
        fi
        ;;
    save_mqtt)
        EN_RAW=$(get_param mqtt_enabled)
        HOST_RAW=$(get_param mqtt_host)
        PORT_RAW=$(get_param mqtt_port)
        PRE_RAW=$(get_param mqtt_prefix)
        USER_RAW=$(get_param mqtt_user)
        PASS_RAW=$(get_param mqtt_pass)

        HOST=$(urldecode "$HOST_RAW" | tr -cd "[:alnum:].-_")
        PORT=$(printf "%d" "$PORT_RAW" 2>/dev/null || echo 1883)
        PRE=$(urldecode "$PRE_RAW" | tr -cd "[:alnum:]_-")
        USER=$(urldecode "$USER_RAW" | tr -cd "[:alnum:]_-")
        PASS=$(urldecode "$PASS_RAW")

        [ "$EN_RAW" = "1" ] || [ "$EN_RAW" = "true" ] && uci set mcud.main.mqtt_enabled="1" 2>/dev/null || uci set mcud.main.mqtt_enabled="0" 2>/dev/null
        [ -n "$HOST" ] && uci set mcud.main.mqtt_host="$HOST" 2>/dev/null
        uci set mcud.main.mqtt_port="$PORT" 2>/dev/null
        [ -n "$PRE" ] && uci set mcud.main.mqtt_topic_prefix="$PRE" 2>/dev/null
        uci set mcud.main.mqtt_user="$USER" 2>/dev/null
        uci set mcud.main.mqtt_password="$PASS" 2>/dev/null

        uci commit mcud 2>/dev/null
        /etc/init.d/mcud restart >/dev/null 2>&1 &
        echo "{\"status\":\"ok\",\"message\":\"MQTT settings saved\"}"
        ;;
    wifi_scan)
        SCAN_RES=$(iwinfo wlan0 scan 2>/dev/null || iwinfo radio0 scan 2>/dev/null)
        SSIDS=$(echo "$SCAN_RES" | grep "ESSID:" | sed -n 's/.*ESSID: "\(.*\)".*/\1/p' | grep -v "^$" | sort -u)
        
        echo -n "{\"status\":\"ok\",\"networks\":["
        FIRST=1
        OLD_IFS="$IFS"
        IFS="
"
        for net in $SSIDS; do
            [ "$FIRST" -eq 1 ] && FIRST=0 || echo -n ","
            NET_ESC=$(echo "$net" | sed 's/\\/\\\\/g;s/"/\\"/g')
            echo -n "\"$NET_ESC\""
        done
        IFS="$OLD_IFS"
        echo "]}"
        ;;
    wifi_connect)
        SSID_RAW=$(get_param ssid)
        [ -z "$SSID_RAW" ] && SSID_RAW=$(get_param wifi_ssid)
        KEY_RAW=$(get_param key)
        [ -z "$KEY_RAW" ] && KEY_RAW=$(get_param pass)
        [ -z "$KEY_RAW" ] && KEY_RAW=$(get_param password)
        [ -z "$KEY_RAW" ] && KEY_RAW=$(get_param wifi_key)
        
        SSID=$(urldecode "$SSID_RAW" | tr -d "\r\n")
        KEY=$(urldecode "$KEY_RAW" | tr -d "\r\n")
        
        if [ -z "$SSID" ]; then
            echo "{\"status\":\"error\",\"message\":\"SSID cannot be empty\"}"
        else
            SAFE_SSID=$(echo "$SSID" | tr -cd "[:alnum:] _.,@#%+=/()[]!?-")
            SAFE_KEY=$(echo "$KEY" | tr -cd "[:alnum:] _.,@#%+=/()[]!?-")
            
            uci set wireless.sta_iface.ssid="$SAFE_SSID" 2>/dev/null
            if [ -n "$SAFE_KEY" ]; then
                uci set wireless.sta_iface.encryption="psk2" 2>/dev/null
                uci set wireless.sta_iface.key="$SAFE_KEY" 2>/dev/null
            else
                uci set wireless.sta_iface.encryption="none" 2>/dev/null
                uci -q del wireless.sta_iface.key 2>/dev/null
            fi
            uci set wireless.sta_iface.disabled="0" 2>/dev/null
            uci commit wireless 2>/dev/null
            
            (sleep 1 && wifi reload) >/dev/null 2>&1 &
            
            SSID_ESC=$(echo "$SAFE_SSID" | sed 's/"/\\"/g')
            echo "{\"status\":\"ok\",\"message\":\"Connecting to $SSID_ESC...\"}"
        fi
        ;;
    reset_wifi)
        uci -q del wireless.sta_iface.ssid 2>/dev/null
        uci -q del wireless.sta_iface.key 2>/dev/null
        uci set wireless.sta_iface.disabled="1" 2>/dev/null
        uci set wireless.ap_iface.disabled="0" 2>/dev/null
        uci commit wireless 2>/dev/null
        (sleep 1 && wifi reload) >/dev/null 2>&1 &
        echo "{\"status\":\"ok\",\"message\":\"Wi-Fi credentials reset. AP mode enabled.\"}"
        ;;
    check_firmware)
        if [ -f /tmp/firmware.bin ]; then
            FILE_SIZE=$(wc -c < /tmp/firmware.bin 2>/dev/null || echo 0)
            MD5=$(md5sum /tmp/firmware.bin 2>/dev/null | cut -d" " -f1)
            IS_VALID=1
            command -v sysupgrade >/dev/null 2>&1 && sysupgrade -T /tmp/firmware.bin >/dev/null 2>&1 || IS_VALID=0
            echo "{\"status\":\"ok\",\"exists\":true,\"size\":$FILE_SIZE,\"md5\":\"$MD5\",\"valid\":$IS_VALID}"
        else
            echo "{\"status\":\"ok\",\"exists\":false}"
        fi
        ;;
    flash_firmware)
        KEEP_CFG_RAW=$(get_param keep_settings)
        [ -z "$KEEP_CFG_RAW" ] && KEEP_CFG_RAW="1"

        if [ ! -f /tmp/firmware.bin ]; then
            echo "{\"status\":\"error\",\"message\":\"Firmware binary /tmp/firmware.bin not found. Upload it first.\"}"
        else
            FILE_SIZE=$(wc -c < /tmp/firmware.bin 2>/dev/null || echo 0)
            MD5=$(md5sum /tmp/firmware.bin 2>/dev/null | cut -d" " -f1)

            if [ "$KEEP_CFG_RAW" = "0" ] || [ "$KEEP_CFG_RAW" = "false" ]; then
                (sleep 3 && sysupgrade -n /tmp/firmware.bin) >/dev/null 2>&1 &
                echo "{\"status\":\"ok\",\"message\":\"Flashing started without saving settings. Device will reboot in 2-3 minutes.\",\"size\":$FILE_SIZE,\"md5\":\"$MD5\",\"keep_settings\":false}"
            else
                (sleep 3 && sysupgrade /tmp/firmware.bin) >/dev/null 2>&1 &
                echo "{\"status\":\"ok\",\"message\":\"Flashing started with settings preserved. Device will reboot in 2-3 minutes.\",\"size\":$FILE_SIZE,\"md5\":\"$MD5\",\"keep_settings\":true}"
            fi
        fi
        ;;
    player_pause|pause)
        send_mcu "AXX+PLM+000\n"
        pidof librespot >/dev/null 2>&1 && kill -STOP $(pidof librespot) 2>/dev/null || true
        [ -f /tmp/audiopro_meta.json ] && sed -i 's/"playing": true/"playing": false/' /tmp/audiopro_meta.json 2>/dev/null || true
        echo "{\"status\":\"ok\",\"playing\":false}"
        ;;
    player_play|play)
        send_mcu "AXX+PLM+001\n"
        send_mcu "AXX+MUT+000\n"
        pidof librespot >/dev/null 2>&1 && kill -CONT $(pidof librespot) 2>/dev/null || true
        [ -f /tmp/audiopro_meta.json ] && sed -i 's/"playing": false/"playing": true/' /tmp/audiopro_meta.json 2>/dev/null || true
        echo "{\"status\":\"ok\",\"playing\":true}"
        ;;
    player_toggle)
        IS_PLAYING=1
        if [ -f /tmp/audiopro_meta.json ] && grep -q '"playing": false' /tmp/audiopro_meta.json; then
            IS_PLAYING=0
        fi
        if [ "$IS_PLAYING" = "1" ]; then
            send_mcu "AXX+PLM+000\n"
            pidof librespot >/dev/null 2>&1 && kill -STOP $(pidof librespot) 2>/dev/null || true
            [ -f /tmp/audiopro_meta.json ] && sed -i 's/"playing": true/"playing": false/' /tmp/audiopro_meta.json 2>/dev/null || true
            echo "{\"status\":\"ok\",\"playing\":false}"
        else
            send_mcu "AXX+PLM+001\n"
            send_mcu "AXX+MUT+000\n"
            pidof librespot >/dev/null 2>&1 && kill -CONT $(pidof librespot) 2>/dev/null || true
            [ -f /tmp/audiopro_meta.json ] && sed -i 's/"playing": false/"playing": true/' /tmp/audiopro_meta.json 2>/dev/null || true
            echo "{\"status\":\"ok\",\"playing\":true}"
        fi
        ;;
    get_presets)
        P1_M=$(uci -q get audiopro_presets.1.mode 2>/dev/null || echo "ha")
        P1_N=$(uci -q get audiopro_presets.1.name 2>/dev/null || echo "Preset 1")
        P1_U=$(uci -q get audiopro_presets.1.url 2>/dev/null || echo "")
        P1_C=$(uci -q get audiopro_presets.1.command 2>/dev/null || echo "")

        P2_M=$(uci -q get audiopro_presets.2.mode 2>/dev/null || echo "ha")
        P2_N=$(uci -q get audiopro_presets.2.name 2>/dev/null || echo "Preset 2")
        P2_U=$(uci -q get audiopro_presets.2.url 2>/dev/null || echo "")
        P2_C=$(uci -q get audiopro_presets.2.command 2>/dev/null || echo "")

        P3_M=$(uci -q get audiopro_presets.3.mode 2>/dev/null || echo "ha")
        P3_N=$(uci -q get audiopro_presets.3.name 2>/dev/null || echo "Preset 3")
        P3_U=$(uci -q get audiopro_presets.3.url 2>/dev/null || echo "")
        P3_C=$(uci -q get audiopro_presets.3.command 2>/dev/null || echo "")

        P4_M=$(uci -q get audiopro_presets.4.mode 2>/dev/null || echo "ha")
        P4_N=$(uci -q get audiopro_presets.4.name 2>/dev/null || echo "Preset 4")
        P4_U=$(uci -q get audiopro_presets.4.url 2>/dev/null || echo "")
        P4_C=$(uci -q get audiopro_presets.4.command 2>/dev/null || echo "")

        echo "{\"status\":\"ok\",\"presets\":[{\"id\":1,\"name\":\"$P1_N\",\"mode\":\"$P1_M\",\"url\":\"$P1_U\",\"command\":\"$P1_C\"},{\"id\":2,\"name\":\"$P2_N\",\"mode\":\"$P2_M\",\"url\":\"$P2_U\",\"command\":\"$P2_C\"},{\"id\":3,\"name\":\"$P3_N\",\"mode\":\"$P3_M\",\"url\":\"$P3_U\",\"command\":\"$P3_C\"},{\"id\":4,\"name\":\"$P4_N\",\"mode\":\"$P4_M\",\"url\":\"$P4_U\",\"command\":\"$P4_C\"}]}"
        ;;
    save_presets)
        PID_RAW=$(get_param id)
        PID=$(printf "%d" "$PID_RAW" 2>/dev/null || echo 1)
        [ "$PID" -lt 1 ] && PID=1
        [ "$PID" -gt 4 ] && PID=4
        
        P_NAME_RAW=$(get_param name)
        P_MODE_RAW=$(get_param mode)
        P_URL_RAW=$(get_param url)
        P_CMD_RAW=$(get_param command)
        
        P_NAME=$(urldecode "$P_NAME_RAW" | tr -cd "[:alnum:] _.,@#%+=/()[]!?-")
        P_MODE=$(urldecode "$P_MODE_RAW" | tr -cd "a-zA-Z0-9_")
        P_URL=$(urldecode "$P_URL_RAW")
        P_CMD=$(urldecode "$P_CMD_RAW")
        
        [ -z "$P_NAME" ] && P_NAME="Preset $PID"
        [ -z "$P_MODE" ] && P_MODE="ha"
        
        uci set audiopro_presets."$PID".name="$P_NAME" 2>/dev/null
        uci set audiopro_presets."$PID".mode="$P_MODE" 2>/dev/null
        uci set audiopro_presets."$PID".url="$P_URL" 2>/dev/null
        uci set audiopro_presets."$PID".command="$P_CMD" 2>/dev/null
        uci commit audiopro_presets 2>/dev/null
        echo "{\"status\":\"ok\",\"message\":\"Preset $PID updated\"}"
        ;;
    get_eq)
        EQ_FILE="/tmp/audiopro_eq.json"
        if [ -f "$EQ_FILE" ]; then
            cat "$EQ_FILE"
        else
            echo "{\"status\":\"ok\",\"b60\":0,\"b250\":0,\"b1k\":0,\"b4k\":0,\"b12k\":0,\"preset\":\"Flat\"}"
        fi
        ;;
    save_eq)
        B60=$(printf "%d" "$(get_param b60)" 2>/dev/null || echo 0)
        B250=$(printf "%d" "$(get_param b250)" 2>/dev/null || echo 0)
        B1K=$(printf "%d" "$(get_param b1k)" 2>/dev/null || echo 0)
        B4K=$(printf "%d" "$(get_param b4k)" 2>/dev/null || echo 0)
        B12K=$(printf "%d" "$(get_param b12k)" 2>/dev/null || echo 0)
        EQ_PRE_RAW=$(get_param preset)
        EQ_PRE=$(urldecode "$EQ_PRE_RAW" | tr -cd "[:alnum:] _-")
        [ -z "$EQ_PRE" ] && EQ_PRE="Custom"
        
        cat << EQ_EOF > /tmp/audiopro_eq.json
{"status":"ok","b60":$B60,"b250":$B250,"b1k":$B1K,"b4k":$B4K,"b12k":$B12K,"preset":"$EQ_PRE"}
EQ_EOF
        echo "{\"status\":\"ok\",\"message\":\"Equalizer updated\",\"preset\":\"$EQ_PRE\"}"
        ;;
    tts|tts_duck)
        TTS_URL_RAW=$(get_param url)
        TTS_URL=$(urldecode "$TTS_URL_RAW")
        if [ -n "$TTS_URL" ]; then
            (/usr/bin/ha_ducking.sh tts "$TTS_URL") >/dev/null 2>&1 &
            echo "{\"status\":\"ok\",\"message\":\"TTS announcement queued\"}"
        else
            echo "{\"status\":\"error\",\"message\":\"URL parameter required\"}"
        fi
        ;;
    play_stream)
        STREAM_URL_RAW=$(get_param url)
        STREAM_NAME_RAW=$(get_param name)
        STREAM_URL=$(urldecode "$STREAM_URL_RAW")
        STREAM_NAME=$(urldecode "$STREAM_NAME_RAW" | tr -cd "[:alnum:] _.,@#%+=/()[]!?-")
        [ -z "$STREAM_NAME" ] && STREAM_NAME="Live Stream"
        
        if [ -n "$STREAM_URL" ]; then
            killall -9 mpg123 madplay 2>/dev/null || true
            cat << JSON_EOF > /tmp/audiopro_meta.json
{"active":true,"source":"webradio","title":"$STREAM_NAME","artist":"Web Radio","album":"Direct Stream","playing":true,"artwork":false,"updated":$(date +%s)}
JSON_EOF
            if command -v mpg123 >/dev/null 2>&1; then
                mpg123 -q -a music_in "$STREAM_URL" >/dev/null 2>&1 &
            fi
            echo "{\"status\":\"ok\",\"message\":\"Streaming started\",\"title\":\"$STREAM_NAME\"}"
        else
            echo "{\"status\":\"error\",\"message\":\"URL required\"}"
        fi
        ;;
    stop_stream)
        killall -9 mpg123 madplay 2>/dev/null || true
        [ -f /tmp/audiopro_meta.json ] && sed -i 's/"playing": true/"playing": false/' /tmp/audiopro_meta.json 2>/dev/null || true
        echo "{\"status\":\"ok\",\"message\":\"Streaming stopped\"}"
        ;;
    reboot)
        (sleep 2 && reboot) >/dev/null 2>&1 &
        echo "{\"status\":\"ok\",\"message\":\"Rebooting...\"}"
        ;;
    *)
        echo "{\"error\":\"unknown command\",\"usage\":\"?volume=50 | ?mute=1 | ?unmute=1 | ?input=wifi|bt|aux | ?status | ?action=get_config | ?action=get_presets | ?action=save_presets | ?action=get_eq | ?action=save_eq | ?action=save_ap | ?action=save_audio | ?action=save_mqtt | ?action=save_device | ?action=wifi_scan | ?action=wifi_connect | ?action=flash_firmware | ?action=check_firmware | ?action=get_security | ?action=save_security | ?action=player_play | ?action=player_pause | ?action=player_toggle | ?action=tts&url=... | ?action=play_stream&url=... | ?action=stop_stream\"}"
        ;;
esac

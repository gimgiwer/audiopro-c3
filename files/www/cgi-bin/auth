#!/bin/sh

# Read config
AUTH_CONF="/etc/audiopro_auth"
AUTH_ENABLED=0
SESSION_TTL=604800
if [ -f "$AUTH_CONF" ]; then
    . "$AUTH_CONF" 2>/dev/null || true
fi

# Directory for transient in-memory sessions
SESS_DIR="/tmp/ap_sessions"
mkdir -p "$SESS_DIR" 2>/dev/null
chmod 700 "$SESS_DIR" 2>/dev/null

# Read POST body if query string is empty
if [ "$REQUEST_METHOD" = "POST" ] && [ -z "$QUERY_STRING" ]; then
    read -r QUERY_STRING
fi

urldecode() {
    echo -n "$1" | awk '
    BEGIN {
        for (i = 0; i < 256; i++) {
            c = sprintf("%c", i);
            hex = sprintf("%02X", i);
            map[hex] = c;
            map[tolower(hex)] = c;
        }
    }
    {
        gsub(/\+/, " ");
        len = length($0);
        res = "";
        for (i = 1; i <= len; i++) {
            ch = substr($0, i, 1);
            if (ch == "%" && i + 2 <= len) {
                h = substr($0, i + 1, 2);
                if (h in map) {
                    res = res map[h];
                    i += 2;
                    continue;
                }
            }
            res = res ch;
        }
        print res;
    }' 2>/dev/null
}

get_param() {
    echo "$QUERY_STRING" | tr '&' '\n' | grep "^$1=" | head -n1 | cut -d'=' -f2-
}

get_cookie() {
    echo "$HTTP_COOKIE" | tr ';' '\n' | grep -i "^[ ]*$1=" | head -n1 | cut -d'=' -f2- | tr -d ' \r\n'
}

compute_fp() {
    # Bind session to client IP and User-Agent signature
    local ua="${HTTP_USER_AGENT:-unknown}"
    local ip="${REMOTE_ADDR:-127.0.0.1}"
    echo -n "${ip}|${ua}" | md5sum | cut -d' ' -f1
}

verify_password() {
    local u="$1" p="$2"
    [ -z "$u" ] && return 1
    
    # If shadow exists, check Linux system password
    if [ -r /etc/shadow ]; then
        local line
        line=$(grep "^${u}:" /etc/shadow 2>/dev/null | head -n1)
        if [ -n "$line" ]; then
            local stored
            stored=$(echo "$line" | cut -d: -f2)
            
            # If a password hash is configured in shadow, it is authoritative
            if [ -n "$stored" ] && [ "$stored" != "*" ] && [ "$stored" != "!" ]; then
                local algo salt
                algo=$(echo "$stored" | cut -d'$' -f2)
                salt=$(echo "$stored" | cut -d'$' -f3)
                
                # Use openssl passwd if available
                if command -v openssl >/dev/null 2>&1; then
                    local computed=""
                    if [ "$algo" = "1" ]; then
                        computed=$(openssl passwd -1 -salt "$salt" "$p" 2>/dev/null)
                    elif [ "$algo" = "5" ]; then
                        computed=$(openssl passwd -5 -salt "$salt" "$p" 2>/dev/null)
                    elif [ "$algo" = "6" ]; then
                        computed=$(openssl passwd -6 -salt "$salt" "$p" 2>/dev/null)
                    fi
                    if [ -n "$computed" ] && [ "$computed" = "$stored" ]; then
                        return 0
                    fi
                fi
                
                # Check via cryptpw / busybox
                if command -v cryptpw >/dev/null 2>&1; then
                    local computed
                    computed=$(cryptpw -m "sha512" -S "$salt" "$p" 2>/dev/null)
                    if [ "$computed" = "$stored" ]; then
                        return 0
                    fi
                fi
                
                # Password hash was configured in shadow but verification failed -> reject
                return 1
            fi
        fi
    fi
    
    # Initial setup fallback only when no password is set in /etc/shadow
    if [ "$u" = "root" ] && [ "$p" = "admin" ]; then
        return 0
    fi
    
    return 1
}

ACTION=$(get_param action)
TOKEN=$(get_cookie ap_sid | tr -cd 'a-f0-9')
FP=$(compute_fp)
NOW=$(date +%s)

# Clean up expired sessions periodically (1 in 10 chance)
if [ $((NOW % 10)) -eq 0 ]; then
    find "$SESS_DIR" -type f -mmin +10080 -delete 2>/dev/null || true
fi

case "$ACTION" in
    login)
        USER_RAW=$(get_param username)
        PASS_RAW=$(get_param password)
        USER=$(urldecode "$USER_RAW" | tr -cd 'a-zA-Z0-9_-')
        PASS=$(urldecode "$PASS_RAW")
        
        [ -z "$USER" ] && USER="root"
        
        # Rate Limiting: Check failed attempts from client IP to prevent CPU exhaustion on SHA-512
        IP_SAFE=$(echo "${REMOTE_ADDR:-127.0.0.1}" | tr -cd "a-fA-F0-9.:")
        FAIL_DIR="/tmp/ap_auth_fails"
        mkdir -p "$FAIL_DIR" 2>/dev/null
        FAIL_FILE="$FAIL_DIR/$IP_SAFE"
        
        FAIL_COUNT=0
        FAIL_TIME=0
        if [ -f "$FAIL_FILE" ]; then
            FAIL_COUNT=$(awk '{print $1}' "$FAIL_FILE" 2>/dev/null || echo 0)
            FAIL_TIME=$(awk '{print $2}' "$FAIL_FILE" 2>/dev/null || echo 0)
        fi
        
        # Lockout for 30s if >= 5 failed attempts within 60s
        if [ "$FAIL_COUNT" -ge 5 ] && [ $((NOW - FAIL_TIME)) -lt 60 ]; then
            echo "Status: 429 Too Many Requests"
            echo "Content-Type: application/json"
            echo ""
            echo "{\"status\":\"error\",\"code\":429,\"message\":\"Too many failed attempts. Please wait 30 seconds.\"}"
            exit 0
        fi
        
        if verify_password "$USER" "$PASS"; then
            # Reset failure count on success
            rm -f "$FAIL_FILE" 2>/dev/null
            
            # Generate 32-hex token
            NEW_TOKEN=$(tr -dc 'a-f0-9' < /dev/urandom 2>/dev/null | head -c 32)
            if [ -z "$NEW_TOKEN" ]; then
                NEW_TOKEN=$(echo "${NOW}_${FP}_${RANDOM}" | md5sum | cut -d' ' -f1)
            fi
            
            EXP=$((NOW + SESSION_TTL))
            cat << SESS_EOF > "$SESS_DIR/$NEW_TOKEN"
username=$USER
expires=$EXP
fingerprint=$FP
created=$NOW
SESS_EOF
            chmod 600 "$SESS_DIR/$NEW_TOKEN" 2>/dev/null
            
            echo "Status: 200 OK"
            echo "Content-Type: application/json"
            echo "Set-Cookie: ap_sid=$NEW_TOKEN; Max-Age=$SESSION_TTL; Path=/; HttpOnly; SameSite=Strict"
            echo ""
            echo "{\"status\":\"ok\",\"message\":\"Authenticated\",\"username\":\"$USER\",\"expires\":$EXP}"
        else
            # Increment failure count
            if [ $((NOW - FAIL_TIME)) -gt 60 ]; then
                FAIL_COUNT=1
            else
                FAIL_COUNT=$((FAIL_COUNT + 1))
            fi
            echo "$FAIL_COUNT $NOW" > "$FAIL_FILE" 2>/dev/null
            
            echo "Status: 403 Forbidden"
            echo "Content-Type: application/json"
            echo ""
            echo "{\"status\":\"error\",\"code\":403,\"message\":\"Invalid credentials\"}"
        fi
        ;;
        
    logout)
        if [ -n "$TOKEN" ] && [ -f "$SESS_DIR/$TOKEN" ]; then
            rm -f "$SESS_DIR/$TOKEN" 2>/dev/null
        fi
        echo "Status: 200 OK"
        echo "Content-Type: application/json"
        echo "Set-Cookie: ap_sid=; Max-Age=0; Path=/; HttpOnly; SameSite=Strict"
        echo ""
        echo "{\"status\":\"ok\",\"message\":\"Logged out\"}"
        ;;
        
    check|*)
        if [ "$AUTH_ENABLED" != "1" ]; then
            echo "Content-Type: application/json"
            echo ""
            echo "{\"auth_required\":false,\"logged_in\":true,\"username\":\"root\",\"fingerprint\":\"$FP\"}"
            exit 0
        fi
        
        LOGGED_IN=0
        SESS_USER=""
        
        if [ -n "$TOKEN" ] && [ -f "$SESS_DIR/$TOKEN" ]; then
            S_USER=$(grep "^username=" "$SESS_DIR/$TOKEN" 2>/dev/null | cut -d'=' -f2-)
            S_EXP=$(grep "^expires=" "$SESS_DIR/$TOKEN" 2>/dev/null | cut -d'=' -f2-)
            S_FP=$(grep "^fingerprint=" "$SESS_DIR/$TOKEN" 2>/dev/null | cut -d'=' -f2-)
            
            if [ -n "$S_EXP" ] && [ "$NOW" -lt "$S_EXP" ] && [ "$S_FP" = "$FP" ]; then
                LOGGED_IN=1
                SESS_USER="$S_USER"
            else
                # Invalidate broken/expired session
                rm -f "$SESS_DIR/$TOKEN" 2>/dev/null
            fi
        fi
        
        echo "Content-Type: application/json"
        echo ""
        if [ "$LOGGED_IN" = "1" ]; then
            echo "{\"auth_required\":true,\"logged_in\":true,\"username\":\"$SESS_USER\",\"fingerprint\":\"$FP\"}"
        else
            echo "{\"auth_required\":true,\"logged_in\":false,\"fingerprint\":\"$FP\"}"
        fi
        ;;
esac

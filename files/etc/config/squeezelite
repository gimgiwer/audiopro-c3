# Slimproto player. This is what Music Assistant / LMS talk to natively, and it
# is the better path than AirPlay here: no ALAC decode and no 2 s RTP buffer.
config options 'options'
	option enabled '1'
	option name 'Audio Pro C3'
	option model_name 'Audio Pro C3'
	# Permanent MAC address pins player ID in Music Assistant / LMS, preserving
	# Spotify Connect state and player configuration across reboots and Wi-Fi/Ethernet.
	option mac_address '02:22:6c:b8:85:ac'
	# squeeze_in is the per-app softvol in asound.conf; it feeds dmix like the
	# other sources, so Spotify and AirPlay can keep playing alongside it.
	option device 'squeeze_in'
	# MA owns its source fader. Master stays the shared output level.
	# A control that does not exist yet is not fatal either - squeezelite logs
	# "Initialization of mixer failed, reverting to software volume" and runs, and
	# softvol controls only appear once their pcm has been opened. mcud opens the
	# chain at startup so both exist before this service starts.
	# Squeezelite internal 32-bit fixed-point DSP volume allows seamless,
	# continuous attenuation down to -72 dB without softvol quantization or 1-2% mute.
	option volume_control ''
	# 44.1k only - the i2s block is clocked for it and dmix runs at that rate
	option max_sr '44100'
	# close device after 5s of idle to eliminate idle CPU load on dmix TPDF dither
	option close_delay '5'
	option priority '0'
	option dsd_over_pcm '0'
	option ircontrol '0'
	option server_addr '10.0.1.6'
	# Hardware-aligned low-latency buffer: 3072 frames (3x 1024-frame hardware DMA periods, ~69.7ms)
	option alsa_params '3072:1024:24:0'
	# Slimproto buffers: 512KB stream / 1024KB output ring
	# Minimum outputbuf must exceed alsa.buffer_size*2 (dmix 16384*2 = 32768 frames = 262KB) + min_space (100KB)
	option buffer_size '512:1024'
	option stream_bufsiz '512'
	option out_bufsiz '1024'


# Slimproto player. This is what Music Assistant / LMS talk to natively, and it
# is the better path than AirPlay here: no ALAC decode and no 2 s RTP buffer.
config options 'options'
	option enabled '1'
	option name 'Audio Pro C3'
	option model_name 'Audio Pro C3'
	# squeeze_in is the per-app softvol in asound.conf; it feeds dmix like the
	# other sources, so Spotify and AirPlay can keep playing alongside it.
	option device 'squeeze_in'
	# -O/-V hand volume to an alsa control instead of squeezelite's own software
	# gain, which keeps our dithered and ramped softvol in charge of the multiply.
	# It has to be the per-source control, NOT Master: squeezelite pushes the
	# server's cached level onto the control every time it (re)connects, and with
	# Master that fought the physical keys - press DOWN and the level climbs back
	# on its own, 4 points at a time. One owner per control, so Master belongs to
	# the panel/HA and Squeeze belongs to the server. Two gains in series is fine,
	# that is just a channel fader under a master fader.
	# A control that does not exist yet is not fatal either - squeezelite logs
	# "Initialization of mixer failed, reverting to software volume" and runs, and
	# softvol controls only appear once their pcm has been opened.
	option mixer_device 'default'
	option volume_control 'Squeeze'
	# 44.1k only - the i2s block is clocked for it and dmix runs at that rate
	option max_sr '44100'
	# hold the device open, reopening dmix mid-queue clicks
	option close_delay '0'
	option priority '0'
	option dsd_over_pcm '0'
	option ircontrol '0'
	# Bigger than the 200/400 KB default: this radio link drops packets and a
	# rebuffer mid-track is worse than 512 KB of RAM on a 56 MB box.
	option stream_bufsiz '512'
	option out_bufsiz '1024'

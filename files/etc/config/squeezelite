config options 'options'
	option name 'Audio Pro C3'
	option model_name 'Audio Pro Addon C3'
	option close_delay '0'
	option priority '0'
	# MT7688 I2S is fixed at 44100 Hz — do not change
	option max_sr '44100'
	# Dedicated softvol path — independent from system aplay sounds
	option device 'squeeze_in'
	option dsd_over_pcm '0'
	option ircontrol '0'
	# Set to LMS server IP if not on the same subnet as this device
	option interface ''
	option enabled '1'

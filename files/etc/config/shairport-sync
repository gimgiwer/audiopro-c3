config shairport-sync 'shairport_sync'
	option enabled '1'
	option respawn '1'
	option name 'Audio Pro C3'
	option output_backend 'alsa'
	option mdns_backend 'avahi'
	option port '5000'
	option alsa_output_device 'airplay_in'
	option alsa_mixer_control_name 'AirPlay'
	# Buffer size in frames @ 44.1kHz:
	# 6615 = 150ms (Default — stable on 2.4GHz Wi-Fi)
	# 2205 =  50ms (Fast home network)
	# 1323 =  30ms (Ultra-low latency / wired)
	#  441 =  10ms (Extreme latency / gigabit LAN only)
	option alsa_buffer_length '6615'
	option alsa_disable_synchronization 'no'
	# 50ms drift threshold before forced resync (0 = disabled, causes glitches on bad Wi-Fi)
	option resync_threshold '2205'
	option ignore_volume_control 'yes'


config librespot 'main'
	option enabled '1'
	option name 'Audio Pro C3'
	option device 'spotify_in'
	option bitrate '320'
	# On a softvol librespot always applies its antilog correction
	# (is_some_linear() is `is_softvol || use_linear_in_db`), so it cancels out
	# and the delivered level is just dB = 20*log10(mapped(pct)). linear maps
	# straight through, so the slider is an amplitude fader: dB = 20*log10(pct/100).
	# Measured raw index on the -60..0 dB Master at 25%: log 250 = -45 dB,
	# cubic 398 = -36 dB, linear 799 = -12 dB. This is also what the factory
	# firmware did (liblpml_alsa.so: gain_Q16 = vol*65536/100), and mcud's
	# vol_curve is generated from the same law so both ends report one number.
	# The cube was here before and put two thirds of the dial below audibility -
	# under 10% clamped to raw 0, which softvol turns into real digital silence.
	# Do not switch this without regenerating vol_curve in mcud.c to match.
	# Caveat: Linear ignores --volume-range and hardcodes 60 dB internally, so the
	# control it writes has to span exactly that - spotify_in is -60..0 dB in
	# asound.conf for this reason. Narrowing it silently flattens the curve.
	option volume_ctrl 'linear'
	# Name it, don't leave it out: 0.8.0 has no "keep current volume" default, it
	# falls back to u16::MAX/2 and writes 50% to whatever control it owns on every
	# connect. 100 = raw max = a plain memcpy, so Spotify's own slider is the only
	# thing that ever attenuates this stage - same deal as Slimproto for MA.
	option initial_volume '100'
	option device_type 'speaker'
	option disable_audio_cache '1'
	# Credentials on flash, so a tap in Spotify is a transfer to an already
	# logged-in session instead of a full zeroconf handshake (~5 s on this CPU).
	option system_cache '/root/.cache/librespot'
	option mixer 'alsa'
	option mixer_device 'default'
	# Spotify owns its source fader; Master stays the shared output level.
	option mixer_control 'Spotify'
	# f64->S16 dither costs a multiply, an add and an RNG draw per sample on a
	# CPU with no FPU, and buys nothing while the ALSA mixer does the attenuation
	option dither 'none'
	# S16 because that is all the i2s block actually plays - it advertises S32_LE
	# and then hands the DAC white noise (see the dmixer comment in asound.conf).
	# Matches spotify_in/Master/dmix, so no conversion happens on the way down.
	option format 'S16'
	# Clip protection. f64_to_s16 quantises with a saturating `as i16` cast, so
	# anything over 0 dBFS turns into a flat top inside librespot - before the
	# Master softvol - and no amount of turning the speaker down undoes it.
	# Spotify masters routinely peak above 0 dBFS (librespot carries track_peak
	# for exactly this). basic is min(replaygain, 1.0/peak) capped at 1.0: peak
	# safe by construction, one f64 multiply per sample. dynamic is the real
	# feedforward limiter but calls ratio_to_db()/db_to_ratio() per sample - two
	# soft-float transcendentals x 88200/s on a core with no FPU, so don't.
	option normalisation '1'
	option normalisation_method 'basic'
	# auto = album gain when the client says it's playing an album, else track
	option normalisation_gain_type 'auto'
	# 1 makes librespot log the volume mapping ("Input volume N mapped to X%",
	# "Setting Alsa raw volume to N") - the only way to see the curve on device.
	option debug '0'
	# env_logger filter, wins over debug=1 if both are set. Left on at player
	# level: it is a couple of lines per track (format, bitrate, and the
	# "Calculated Normalisation Factor" that proves the limiter is engaging on
	# real material), and it is the log we always want when a track sounds wrong.
	option log_filter 'librespot=info,librespot_playback::player=debug'


config librespot 'main'
	option enabled '1'
	option name 'Audio Pro C3'
	option device 'spotify_in'
	option bitrate '320'
	# On a softvol librespot always applies its antilog correction
	# (is_some_linear() is `is_softvol || use_linear_in_db`), so the curve you
	# pick is the curve you get. Measured raw index on the -60..0 dB Master at
	# 25%: log 250 = -45 dB, cubic 511 = -29 dB, linear 799 = -12 dB. Stock's
	# law was gain = vol/100, i.e. exactly linear, but that crams everything
	# usable into the bottom fifth of the dial. cubic puts a comfortable
	# -20 dB at 40%, which is why it wins here.
	option volume_ctrl 'cubic'
	# Name it, don't leave it out: 0.8.0 has no "keep current volume" default, it
	# falls back to u16::MAX/2 and writes 50% to Master on every connect.
	option initial_volume '25'
	option device_type 'speaker'
	option disable_audio_cache '1'
	# Credentials on flash, so a tap in Spotify is a transfer to an already
	# logged-in session instead of a full zeroconf handshake (~5 s on this CPU).
	option system_cache '/root/.cache/librespot'
	option mixer 'alsa'
	option mixer_device 'default'
	option mixer_control 'Master'
	# f64->S16 dither costs a multiply, an add and an RNG draw per sample on a
	# CPU with no FPU, and buys nothing while the ALSA mixer does the attenuation
	option dither 'none'
	# S16 because that is all the i2s block actually plays - it advertises S32_LE
	# and then hands the DAC white noise (see the dmixer comment in asound.conf).
	# Matches spotify_in/Master/dmix, so no conversion happens on the way down.
	option format 'S16'
	# 1 makes librespot log the volume mapping ("Input volume N mapped to X%",
	# "Setting Alsa raw volume to N") - the only way to see the curve on device.
	option debug '0'

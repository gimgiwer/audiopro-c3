config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

# Ethernet: Client mode (automatic DHCP from home router)
# Metric 700, so the cable is NOT the default route - the wifi station is, even
# when both are up. The two links get two different leases (10.0.100.4 vs
# 10.0.100.3) and TCP cannot move a session between source addresses, so whichever
# link the players dial out over, losing it costs a reconnect. Pulling the cable
# mid-track used to kill playback for minutes; with the audio path permanently on
# wifi, unplugging it now changes nothing at all. It also sidesteps this unit's
# flapping cable (16 link events in 2h45m). eth stays fully up and addressed - it
# is the maintenance and breed-recovery path, and it still answers on its own IP.
config interface 'lan'
	option device 'eth0'
	option proto 'dhcp'
	option metric '700'

# Wi-Fi AP Hotspot: Standalone setup mode (dedicated 10.10.10.254/24 subnet with DHCP server)
config interface 'ap'
	option proto 'static'
	option ipaddr '10.10.10.254'
	option netmask '255.255.255.0'


# Wi-Fi STA: Client mode (connects to home Wi-Fi and gets DHCP from home router)
config interface 'wwan'
	option proto 'dhcp'
	option metric '600'

# uhttpd listens on [::]:80 and [::]:443, so without these the v6 sockets
# have nothing to bind to
config interface 'lan6'
	option device 'eth0'
	option proto 'dhcpv6'
	option reqaddress 'try'
	option reqprefix 'no'
	option metric '700'

config interface 'wwan6'
	option device '@wwan'
	option proto 'dhcpv6'
	option reqaddress 'try'
	option reqprefix 'no'
	option metric '600'

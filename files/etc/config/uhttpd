config uhttpd 'main'
	list listen_http '0.0.0.0:80'
	list listen_http '[::]:80'
	list listen_https '0.0.0.0:443'
	list listen_https '[::]:443'
	option home '/www'
	option rfc1918_filter '0'
	option max_requests '100'
	option max_connections '100'
	option cert '/etc/uhttpd.crt'
	option key '/etc/uhttpd.key'
	option script_timeout '60'
	option network_timeout '60'
	option http_keepalive '20'
	option tcp_keepalive '1'
	option redirect_https '0'
	option lua_prefix '/api'
	option lua_handler '/www/api.lua'
	# ChaCha20-Poly1305 is ARX-only, so it beats AES on a core with no crypto accel.
	# Needs the ec cert below, or the ECDSA suites never negotiate and you eat a
	# 1.25s RSA-2048 handshake instead of 0.36s.
	option ciphers 'ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-CHACHA20-POLY1305'

config cert 'defaults'
	option days '36500'
	option key_type 'ec'
	option ec_curve 'P-256'
	option country 'SE'
	option state 'Stockholm'
	option location 'Stockholm'
	option commonname 'Audio Pro C3'
	option organization 'Audio Pro AB'

config system
	option hostname 'audiopro'
	option timezone 'UTC'
	option ttylogin '0'
	option log_size '128'
	option urandom_seed '0'
	# lzo-rle is the rle-aware variant of the same codec: same speed class, much
	# better on the zero-filled pages that dominate swap on this box
	option zram_comp_algo 'lzo-rle'

config timeserver 'ntp'
	option enabled '1'
	option enable_server '0'
	list server '0.openwrt.pool.ntp.org'
	list server '1.openwrt.pool.ntp.org'
	list server '2.openwrt.pool.ntp.org'
	list server '3.openwrt.pool.ntp.org'

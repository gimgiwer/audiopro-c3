# Baresip configuration for Audio Pro C3

# Core
poll_method		epoll
sip_listen		0.0.0.0:5060

# Audio Output (Speaker) -> dedicated voip_in channel with ducking support
audio_player		alsa,voip_in

# Audio Input (Microphone) -> Dummy, since this is a playback-only speaker
audio_source		null,null

# Modules
module_path		/usr/lib/baresip/modules
module			alsa.so
module			g711.so
module			turn.so
module			stun.so
module			menu.so
module			mqtt.so

# Auto-answer for Paging/Intercom
module			ctrl_dbus.so
# Or we can just use the auto-answer feature in account config

# MQTT control (optional, allows HA to control SIP via MQTT)
mqtt_broker_host	127.0.0.1
mqtt_broker_port	1883

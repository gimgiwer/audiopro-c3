# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# Snapshot the first half minute of syslog. The ring buffer wraps within hours,
# so boot problems are unreadable by the time anyone looks.
(sleep 30; logread > /tmp/boot.log) &

# Start AirPlay metadata and artwork collector
[ -x /usr/share/audiopro/meta_airplay.sh ] && /usr/share/audiopro/meta_airplay.sh &

exit 0

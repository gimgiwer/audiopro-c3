# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# Ensure 32MB ZRAM Swap is enabled on every boot for 64MB RAM SoC
if [ -e /dev/zram0 ] && ! swapon -s | grep -q "/dev/zram0"; then
    echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null || echo lzo-rle > /sys/block/zram0/comp_algorithm 2>/dev/null
    echo $((32 * 1024 * 1024)) > /sys/block/zram0/disksize 2>/dev/null
    mkswap /dev/zram0 >/dev/null 2>&1
    swapon -p 100 /dev/zram0 >/dev/null 2>&1
fi

# Start AirPlay metadata and artwork collector
[ -x /usr/share/audiopro/meta_airplay.sh ] && /usr/share/audiopro/meta_airplay.sh &

exit 0

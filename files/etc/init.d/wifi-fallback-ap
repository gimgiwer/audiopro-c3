#!/bin/sh /etc/rc.common
# Fallback Access Point daemon for Audio Pro C3
# Activates setup hotspot when neither Ethernet nor Wi-Fi STA connection is available.
START=99
USE_PROCD=1

EXTRA_COMMANDS="monitor"
EXTRA_HELP="        monitor Run background monitoring loop"

GRACE_PERIOD=40
POLL_INTERVAL=5

is_connected() {
	# 1. Check physical Ethernet carrier directly from kernel sysfs
	if [ -f /sys/class/net/eth0/carrier ] && [ "$(cat /sys/class/net/eth0/carrier 2>/dev/null)" = "1" ]; then
		return 0
	fi

	# 2. Check Wi-Fi L3 status via netifd wwan interface
	if ubus call network.interface.wwan status 2>/dev/null | grep -q '"up": true'; then
		return 0
	fi

	# 3. Check Wi-Fi L2 link status via Linux nl80211 driver
	if iw dev phy0-sta0 link 2>/dev/null | grep -q "Connected to"; then
		return 0
	fi

	return 1
}

enable_fallback_ap() {
	logger -t wifi-fallback-ap "No network connectivity detected (no Ethernet, no Wi-Fi STA). Enabling Fallback AP mode..."
	
	# Enable AP interface in wireless config
	uci -q set wireless.ap_iface.disabled='0'
	uci -q commit wireless

	# Reload wifi to dynamically bring up hostapd on ap_iface
	wifi reload >/dev/null 2>&1

	# Start DHCP server for 10.10.10.254 subnet
	/etc/init.d/dnsmasq start >/dev/null 2>&1

	# Start uhttpd for web configuration portal
	/etc/init.d/uhttpd start >/dev/null 2>&1

	logger -t wifi-fallback-ap "Fallback AP 'AudioPro-C3-Setup' active at 10.10.10.254"
}

disable_fallback_ap() {
	logger -t wifi-fallback-ap "Network connectivity restored. Disabling Fallback AP mode..."

	# Disable AP interface
	uci -q set wireless.ap_iface.disabled='1'
	uci -q commit wireless

	# Reload wifi to tear down AP without disrupting STA
	wifi reload >/dev/null 2>&1

	# Stop standalone services to conserve RAM and CPU
	/etc/init.d/uhttpd stop >/dev/null 2>&1
	/etc/init.d/dnsmasq stop >/dev/null 2>&1

	logger -t wifi-fallback-ap "Fallback AP disabled. Resumed client STA mode."
}

monitor() {
	# Close inherited procd service lock descriptor to prevent flock deadlock on restarts
	exec 1000>&- 2>/dev/null

	# Wait for boot grace period to allow normal STA association and DHCP
	sleep $GRACE_PERIOD

	local ap_active=0
	if [ "$(uci -q get wireless.ap_iface.disabled)" != "1" ] || iw dev phy0-ap0 info >/dev/null 2>&1; then
		ap_active=1
	fi

	while true; do
		if is_connected; then
			if [ "$ap_active" -eq 1 ]; then
				disable_fallback_ap
				ap_active=0
			fi
		else
			if [ "$ap_active" -eq 0 ]; then
				enable_fallback_ap
				ap_active=1
			fi
		fi
		sleep $POLL_INTERVAL
	done
}

start_service() {
	procd_open_instance "wifi-fallback-ap"
	procd_set_param command /etc/init.d/wifi-fallback-ap monitor
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

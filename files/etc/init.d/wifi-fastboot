#!/bin/sh /etc/rc.common
# Procd service for fast Wi-Fi association monitoring and hidden SSID fallback.
START=13
USE_PROCD=1

EXTRA_COMMANDS="monitor"
EXTRA_HELP="        monitor Run watchdog loop"

WATCHDOG_TIMEOUT=20
DEBOUNCE_RETRIES=3

check_l2_link() {
	# 1. Check L3 status via netifd wwan
	if ubus call network.interface.wwan status 2>/dev/null | grep -q '"up": true'; then
		return 0
	fi

	# 2. Check L2 link status via iw
	if iw dev phy0-sta0 link 2>/dev/null | grep -q "Connected to"; then
		return 0
	fi

	return 1
}

recover_hidden_network() {
	local iface="phy0-sta0"
	local ssid
	ssid=$(uci -q get wireless.sta_iface.ssid || echo "IoT")

	logger -t wifi-fastboot "Link lost or not associated after ${WATCHDOG_TIMEOUT}s. Triggering directed probe scan for SSID: ${ssid}..."
	# Hidden APs do not answer broadcast probes; directed scan forces immediate probe response
	iw dev "$iface" scan ssid "$ssid" >/dev/null 2>&1
}

monitor() {
	# Close inherited procd service lock descriptor to prevent flock deadlock
	exec 1000>&- 2>/dev/null

	# Allow fast cached association to complete during boot
	sleep $WATCHDOG_TIMEOUT

	if check_l2_link; then
		logger -t wifi-fastboot "L2 association established successfully on cached parameters."
		exit 0
	fi

	# If association failed, perform debounced directed scans
	local retries=0
	while [ $retries -lt $DEBOUNCE_RETRIES ]; do
		recover_hidden_network
		sleep 3
		if check_l2_link; then
			logger -t wifi-fastboot "Recovered association to hidden network after directed scan."
			exit 0
		fi
		retries=$((retries + 1))
	done

	if [ -n "$(uci -q get wireless.radio0.scan_list)" ] || [ -n "$(uci -q get wireless.sta_iface.bssid)" ]; then
		logger -t wifi-fastboot "Warning: Unable to associate on cached channel/BSSID. Clearing cache for full-band scan..."
		uci -q delete wireless.radio0.scan_list
		uci -q delete wireless.sta_iface.bssid
		uci commit wireless
		wifi reload >/dev/null 2>&1
	else
		logger -t wifi-fastboot "Warning: Unable to associate after directed scans. Letting netifd resume standard cycle."
	fi
}

start_service() {
	# Asynchronously trigger netifd to bring up wireless immediately at START=21,
	# without waiting for procd rcS queue completion (eliminates ~16s idle wait).
	(
		ubus -t 5 wait_for network.wireless 2>/dev/null
		ubus call network.wireless up 2>/dev/null
	) &

	procd_open_instance "wifi-fastboot"
	procd_set_param command /etc/init.d/wifi-fastboot monitor
	procd_close_instance
}

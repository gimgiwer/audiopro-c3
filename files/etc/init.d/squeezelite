#!/bin/sh /etc/rc.common
# Copyright (C) 2015 OpenWrt.org

START=99
STOP=1

USE_PROCD=1
PROG=/usr/bin/squeezelite

# Check if a codec is disabled in the configuration (ie "decode_<codec> 0")
checkcodec() {
	local codec
	config_get_bool codec options "$1" 1

	if [ "$codec" -eq 0 ] ; then
		if [ -z "$3" ] ; then
			echo "$2"
		else
			echo "$3,$2"
		fi
	else
		echo "$3"
	fi
}

# procd word-splits the command array it is given, so every argument that can
# hold a space (the player name, for one) has to be appended on its own
add() {
	cmdline="$cmdline $*"
	procd_append_param command "$@"
}

make_cmdline() {
	cmdline=""

	local name
	config_get name options name "SqueezeWrt"
	add -n "$name"

	local model_name
	config_get model_name options model_name "SqueezeLite"
	add -M "$model_name"

	local interface
	config_get interface options interface ""
	[ -n "$interface" ] && add -I "$interface"

	local device
	config_get device options device ""
	[ -n "$device" ] && add -o "$device"

	# -V hands volume to an ALSA control instead of squeezelite's own software
	# gain, so LMS/Music Assistant moves the same Master as Spotify, AirPlay and
	# the panel buttons. -O because the output device is a plugin PCM, not a ctl.
	local mixer_device volume_control
	config_get mixer_device options mixer_device ""
	config_get volume_control options volume_control ""
	[ -n "$mixer_device" ] && add -O "$mixer_device"
	[ -n "$volume_control" ] && add -V "$volume_control"

	local alsa_buffer
	config_get alsa_buffer options alsa_buffer 200
	[ "$alsa_buffer" -eq 0 ] && alsa_buffer="200"

	local alsa_period
	config_get alsa_period options alsa_period 4
	[ "$alsa_period" -eq 0 ] && alsa_period="4"

	local alsa_format
	config_get alsa_format options alsa_format 16
	[ "$alsa_format" = "0" ] && alsa_format="16"

	local alsa_mmap
	config_get alsa_mmap options alsa_mmap 0
	add -a "$alsa_buffer:$alsa_period:$alsa_format:$alsa_mmap"

	local stream_bufsiz
	local out_bufsiz
	config_get stream_bufsiz options stream_bufsiz 2048
	config_get out_bufsiz options out_bufsiz 3763
	add -b "$stream_bufsiz:$out_bufsiz"

	local max_sr
	config_get max_sr options max_sr 0
	[ "$max_sr" -ne 0 ] && {
		local sr_delay
		config_get sr_delay options sr_delay 0
		[ "$sr_delay" -ne 0 ] && max_sr="$max_sr:$sr_delay"
		add -r "$max_sr"
	}

	local close_delay
	config_get close_delay options close_delay 0
	[ "$close_delay" -ne 0 ] && add -C "$close_delay"

	local server_addr
	config_get server_addr options server_addr ""
	[ -n "$server_addr" ] && {
		local server_port
		config_get server_port options server_port 3483
		add -s "$server_addr:$server_port"
	}

	local priority
	config_get priority options priority 0
	[ "$priority" -ne 0 ] && add -p "$priority"

	local excl_codecs=""
	excl_codecs=$(checkcodec decode_flac flac "$excl_codecs")
	excl_codecs=$(checkcodec decode_mp3 mp3 "$excl_codecs")
	excl_codecs=$(checkcodec decode_aac aac "$excl_codecs")
	excl_codecs=$(checkcodec decode_ogg ogg "$excl_codecs")
	excl_codecs=$(checkcodec decode_wma_alac wma,alac "$excl_codecs")
	[ -n "$excl_codecs" ] && add -e "$excl_codecs"

	local dop
	config_get dop options dsd_over_pcm 0
	[ "$dop" -eq 1 ] && add -D
}

start_service() {
	config_load squeezelite

	local enabled
	config_get_bool enabled options 'enabled' 0
	[ "$enabled" -eq 0 ] && return

	procd_open_instance
	procd_set_param command "$PROG"
	make_cmdline
	logger -t 'squeezelite' "$cmdline"
	# renice does not exist in this busybox, so procd is the only place a
	# priority can be set at all - see the dilation table in the librespot init
	procd_set_param nice -10
	procd_close_instance
}

# Wait for service to exit and release sockets
reload_service() {
	stop
	sleep 2
	start
}

restart() {
	reload_service
}

#!/bin/sh /etc/rc.common

START=90
STOP=15

USE_PROCD=1
PROG=/usr/bin/librespot

start_service() {
    local enabled name device bitrate volume vol_ctrl dev_type disable_cache
    local mixer mixer_dev mixer_ctl dither format syscache
    local normalise norm_method norm_type norm_pregain
    local fifo=/tmp/librespot_cmd

    config_load librespot
    config_get_bool enabled main enabled 1
    [ "$enabled" -eq 1 ] || return 0

    config_get name main name 'Audio Pro C3'
    config_get device main device 'spotify_in'
    config_get bitrate main bitrate '320'
    config_get volume main initial_volume ''
    config_get vol_ctrl main volume_ctrl 'linear'
    config_get dev_type main device_type 'speaker'
    config_get_bool disable_cache main disable_audio_cache 1
    config_get mixer main mixer 'alsa'
    config_get mixer_dev main mixer_device 'default'
    config_get mixer_ctl main mixer_control 'Master'
    config_get dither main dither 'none'
    config_get format main format 'S16'
    config_get syscache main system_cache ''
    config_get_bool normalise main normalisation 1
    config_get norm_method main normalisation_method 'basic'
    config_get norm_type main normalisation_gain_type 'auto'
    config_get norm_pregain main normalisation_pregain ''
    config_get_bool debug main debug 0
    config_get log_filter main log_filter ''

    local args="--backend alsa --device $device --bitrate $bitrate --name \"$name\" --volume-ctrl $vol_ctrl --device-type $dev_type --onevent /usr/bin/spotify_event_handler.sh --dither $dither --format $format"

    # 0.8.0 does NOT fall back to "the current volume" with --mixer alsa: main.rs
    # ends with unwrap_or(ConnectConfig::default()), i.e. u16::MAX/2, and Spirc::new
    # writes it to the control it owns. Leaving this empty means every start (and
    # every zeroconf handover) silently drops the Spotify stage to 50%, i.e. -25 dB
    # under everything else. uci names 100 instead, so the stage is transparent
    # until the phone's slider moves it. Master is mcud's, not librespot's - see
    # mixer_control in /etc/config/librespot.
    [ -n "$volume" ] && args="$args --initial-volume $volume"
    [ "$disable_cache" -eq 1 ] && args="$args --disable-audio-cache"

    # Clip protection. Nothing downstream of librespot can undo a clip: f64_to_s16
    # quantises with a saturating `as i16` cast, so anything over 0 dBFS becomes a
    # flat top right there, and the Master softvol attenuates only afterwards -
    # turning the speaker down does not save it. Spotify masters routinely peak
    # above 0 dBFS, which librespot itself expects (it carries track_peak for this).
    # Basic is min(replaygain, 1.0/peak) capped at 1.0: one f64 multiply per sample,
    # peak-safe by construction. Dynamic is the real feedforward limiter but calls
    # ratio_to_db() and db_to_ratio() per sample - two soft-float transcendentals
    # x 88200 samples/s on a core with no FPU, so it stays available but off.
    if [ "$normalise" -eq 1 ]; then
        args="$args --enable-volume-normalisation --normalisation-method $norm_method"
        args="$args --normalisation-gain-type $norm_type"
        [ -n "$norm_pregain" ] && args="$args --normalisation-pregain $norm_pregain"
    fi

    # Credentials on flash: with them librespot logs into the AP at boot, so tapping
    # the speaker in Spotify is a transfer to a live session instead of a full
    # zeroconf handover (blob decrypt + AP handshake + token, ~5 s on this CPU).
    # The volume file lives in the same dir and is rewritten on every slider move,
    # so park it in tmpfs - nothing in 0.8.0 ever reads it back anyway.
    if [ -n "$syscache" ]; then
        mkdir -p "$syscache"
        [ -L "$syscache/volume" ] || { rm -f "$syscache/volume"; ln -s /tmp/librespot_volume "$syscache/volume"; }
        args="$args --system-cache $syscache"
    fi

    # Attenuate in the softvol stage named by uci, not in librespot's own float
    # multiply: the stage dithers the 16-bit product and sits in the same chain
    # everything else uses.
    args="$args --mixer $mixer"
    [ "$mixer" = "alsa" ] && args="$args --alsa-mixer-device $mixer_dev --alsa-mixer-control \"$mixer_ctl\""

    # Local transport control: Spotify Connect has no way for the speaker itself
    # to press play, so player_control.sh feeds commands in here. librespot holds
    # it open read+write, so writers never block. The flag is ours (see
    # patches/librespot/), so probe for it - an unpatched binary treats it as a
    # usage error and procd just respawn-loops it forever.
    # grep -q closes the pipe on the first match, librespot panics writing the rest
    # of --help into it, and the release profile is panic=abort, so procd logged
    # "S90librespot: Aborted" on every boot. Read the whole thing, then match.
    case "$($PROG --help 2>&1)" in
        *--control-fifo*)
            [ -p "$fifo" ] || { rm -f "$fifo"; mkfifo -m 0644 "$fifo"; }
            args="$args --control-fifo $fifo"
            ;;
        *)
            logger -t librespot "binary has no --control-fifo, local transport control disabled"
            ;;
    esac

    # procd already pipes stdout/stderr into syslog, so this is the cheap way to
    # get timestamped state/volume traces when connect feels sluggish
    [ "$debug" -eq 1 ] && args="$args --verbose"

    # debug=1 is librespot=trace, which buries the log under a keep-alive ping
    # every 60 s. log_filter is the surgical version: env_logger filter syntax,
    # and setup_logging() prefers RUST_LOG over --verbose, so it wins if both are
    # set. Useful ones: librespot_playback::player=debug for the per-track
    # normalisation factor, librespot_playback::mixer=debug for the volume law,
    # librespot_connect::spirc=debug for Connect handovers.


    # librespot exits when it cannot reach the AP and procd's respawn then reloads
    # 7.35 MB off jffs2 every 5 s. Measured: at S90 it execs at t+28 while dnsmasq
    # gets its first upstream server at t+54, so it burned three instances before
    # the fourth stuck, and Connect only came up at t+73. Wait inside the instance
    # instead - procd sees the shell as alive so nothing respawns, and a sleeping
    # shell also keeps a nice -12 process off netifd's back while it is still
    # bringing lan up. Bounded, so no network at all just falls through.
    #
    # The gate probes the endpoint, not the resolver. A plain nslookup is not
    # enough: on the 2026-08-22 boot dnsmasq answered at t+38.5, librespot exec'd
    # on that same second and its first attempt still died at t+45.5 with
    # "could not initialize spirc: Service unavailable { client error (Connect) }",
    # which cost a full respawn cycle - Connect appeared at t+54 instead of ~t+42.
    # busybox wget here has tls (ssl_client is installed), so one request covers
    # dns, the route and the handshake against the exact host librespot resolves
    # against first.
    local wait_net='n=0; while [ $n -lt 60 ] && ! wget -q -O /dev/null -T 4 https://apresolve.spotify.com/ 2>/dev/null; do n=$((n+1)); sleep 1; done'

    procd_open_instance
    procd_set_param command /bin/sh -c "$wait_net; exec $PROG $args"
    [ -n "$log_filter" ] && procd_set_param env RUST_LOG="$log_filter"
    # Single core, and AlsaSink is synchronous so decode and output share this
    # thread. Measured on hardware at 6 competing nice-0 hogs: playback stretches
    # +4.7% without this, +1.6% at -12. Gains flatten past -12, and SCHED_FIFO is
    # deliberately avoided -- a busy-looping RT decoder on one core starves procd's
    # 30s watchdog and reboots the speaker.
    procd_set_param nice -12
    # procd's default stop is TERM then KILL after 5 s, and a -9'd alsa client
    # wedges dmix for everyone until the speaker is power-cycled. Give it room:
    # a slow exit costs seconds, a killed one costs the whole card.
    procd_set_param term_timeout 15
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param user root
    procd_close_instance
}


#!/bin/sh /etc/rc.common

START=90
STOP=15

USE_PROCD=1
PROG=/usr/bin/librespot-wrapper.sh

start_service() {
    procd_open_instance
    procd_set_param command "$PROG" \
        --name "Audio Pro C3" \
        --backend alsa \
        --device spotify_in \
        --mixer softvol \
        --bitrate 320 \
        --disable-audio-cache \
        --onevent /usr/share/audiopro/meta_spotify.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

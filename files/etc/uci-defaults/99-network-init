#!/bin/sh

# SSH access configuration: ensure password auth is enabled by default.
uci set dropbear.@dropbear[0].PasswordAuth='on'
uci set dropbear.@dropbear[0].RootPasswordAuth='on'
uci commit dropbear 2>/dev/null

# Configure Ethernet LAN as automatic DHCP client (smart speaker mode)
uci set network.lan.proto='dhcp'
uci -q delete network.lan.ipaddr
uci -q delete network.lan.netmask
uci -q delete network.lan.ip6assign

# Configure dedicated Wi-Fi AP Hotspot interface (10.10.10.254/24 with DHCP server)
uci set network.ap=interface
uci set network.ap.proto='static'
uci set network.ap.ipaddr='10.10.10.254'
uci set network.ap.netmask='255.255.255.0'
uci commit network 2>/dev/null

# Wi-Fi AP binds to 'ap' network with dedicated DHCP server
uci set wireless.ap_iface.network='ap'
uci commit wireless 2>/dev/null

# Dedicated DHCP server on 'ap' interface (10.10.10.100 - 10.10.10.200); disabled on Ethernet 'lan'
uci set dhcp.ap=dhcp
uci set dhcp.ap.interface='ap'
uci set dhcp.ap.start='100'
uci set dhcp.ap.limit='100'
uci set dhcp.ap.leasetime='1h'
uci set dhcp.ap.dhcpv4='server'
uci set dhcp.lan.ignore='1'
uci commit dhcp 2>/dev/null


# Add 'ap' to firewall lan zone
uci -q del_list firewall.@zone[0].network='ap'
uci add_list firewall.@zone[0].network='ap'
uci commit firewall 2>/dev/null


# Enable 32MB ZRAM Swap with ultra-fast lz4 compression on 64MB RAM SoC
if [ -e /dev/zram0 ]; then
    echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null || echo lzo-rle > /sys/block/zram0/comp_algorithm 2>/dev/null
    zram_size=$((32 * 1024 * 1024))
    echo $zram_size > /sys/block/zram0/disksize 2>/dev/null
    mkswap /dev/zram0 2>/dev/null
    swapon -p 100 /dev/zram0 2>/dev/null
fi

# Firewall rules for HTTP (80) & HTTPS (443)
uci add firewall rule 2>/dev/null
uci set firewall.@rule[-1].name='Allow-HTTP' 2>/dev/null
uci set firewall.@rule[-1].src='*' 2>/dev/null
uci set firewall.@rule[-1].proto='tcp' 2>/dev/null
uci set firewall.@rule[-1].dest_port='80' 2>/dev/null
uci set firewall.@rule[-1].target='ACCEPT' 2>/dev/null

uci add firewall rule 2>/dev/null
uci set firewall.@rule[-1].name='Allow-HTTPS' 2>/dev/null
uci set firewall.@rule[-1].src='*' 2>/dev/null
uci set firewall.@rule[-1].proto='tcp' 2>/dev/null
uci set firewall.@rule[-1].dest_port='443' 2>/dev/null
uci set firewall.@rule[-1].target='ACCEPT' 2>/dev/null

uci commit firewall 2>/dev/null

# Generate 100-year ECDSA (prime256v1) HTTPS SSL certificate if not present
if [ ! -f /etc/uhttpd.crt ] || [ ! -f /etc/uhttpd.key ]; then
    if command -v openssl >/dev/null 2>&1; then
        # Ultra-fast ECDSA prime256v1 for MIPS 24KEc (10x faster handshake than RSA)
        openssl ecparam -genkey -name prime256v1 -out /etc/uhttpd.key 2>/dev/null
        openssl req -new -x509 -key /etc/uhttpd.key -out /etc/uhttpd.crt \
            -days 36500 -subj "/C=SE/ST=Stockholm/L=Stockholm/O=Audio Pro AB/CN=Audio Pro C3" -sha256 2>/dev/null
    fi
    if [ ! -f /etc/uhttpd.crt ] || [ ! -f /etc/uhttpd.key ]; then
        if command -v px5g >/dev/null 2>&1; then
            px5g selfsigned -days 36500 -newkey rsa:2048 -keyout /etc/uhttpd.key -out /etc/uhttpd.crt \
                -subj "/C=SE/ST=Stockholm/L=Stockholm/O=Audio Pro AB/CN=Audio Pro C3" 2>/dev/null
        fi
    fi
    chmod 600 /etc/uhttpd.key 2>/dev/null
fi

exit 0

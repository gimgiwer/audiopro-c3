#!/bin/sh
# Dynamic Wi-Fi channel caching for Fast Boot (never lock BSSID so AP MAC changes do not break association)
[ "$ACTION" = "ifup" ] || exit 0
[ "$INTERFACE" = "wwan" ] || exit 0

WLAN_DEV="phy0-sta0"
LINK_INFO=$(iw dev "$WLAN_DEV" link 2>/dev/null)
CURRENT_FREQ=$(echo "$LINK_INFO" | awk '/freq:/{print $2}')

[ -n "$CURRENT_FREQ" ] || exit 0

CACHED_FREQ=$(uci -q get wireless.radio0.scan_list)
CACHED_BSSID=$(uci -q get wireless.sta_iface.bssid)

if [ "$CACHED_FREQ" != "$CURRENT_FREQ" ] || [ -n "$CACHED_BSSID" ]; then
    logger -t wifi-cache "Updating Wi-Fi channel cache: freq=$CURRENT_FREQ (clearing BSSID lock)"
    uci -q delete wireless.radio0.scan_list
    uci add_list wireless.radio0.scan_list="$CURRENT_FREQ"
    uci -q delete wireless.sta_iface.bssid
    uci commit wireless
fi


+    // Spotify Connect gives the device itself no way to press play, so the web
+    // ui and the front panel button feed commands in through a fifo and we
+    // replay them as spirc commands. Same path a phone tap takes, so position
+    // and the app ui stay in sync -- unlike muting a softvol, which keeps the
+    // stream running and loses your place.
+    let mut control_rx = setup.control_fifo.as_ref().map(|path| {
+        let (tx, rx) = tokio::sync::mpsc::unbounded_channel();
+        let path = path.clone();
+        std::thread::spawn(move || {
+            loop {
+                // Read+write, not read-only, for two reasons: a read-only open
+                // blocks until some writer turns up, and it hands us EOF every
+                // time the last writer leaves. Holding a write end ourselves
+                // means the fifo always has a reader, so uhttpd and mcud can
+                // never block writing to it, and reads just wait for data.
+                match std::fs::OpenOptions::new().read(true).write(true).open(&path) {
+                    Ok(f) => {
+                        for line in std::io::BufReader::new(f).lines().map_while(Result::ok) {
+                            let cmd = line.trim().to_ascii_lowercase();
+                            if !cmd.is_empty() && tx.send(cmd).is_err() {
+                                return;
+                            }
+                        }
+                    }
+                    Err(e) => {
+                        warn!("control fifo {path}: {e}");
+                        std::thread::sleep(Duration::from_secs(5));
+                    }
+                }
+            }
+        });
+        rx
+    });

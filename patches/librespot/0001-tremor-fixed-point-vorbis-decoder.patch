diff --git a/playback/build.rs b/playback/build.rs
new file mode 100644
index 0000000..8eb256a
--- /dev/null
+++ b/playback/build.rs
@@ -0,0 +1,57 @@
+use std::{env, path::PathBuf};
+
+fn main() {
+    // Nothing to do unless the fixed-point Vorbis decoder was asked for.
+    if env::var_os("CARGO_FEATURE_TREMOR_DECODER").is_none() {
+        return;
+    }
+
+    let tremor = PathBuf::from(
+        env::var("TREMOR_SRC").expect("TREMOR_SRC must point at a libvorbisidec source tree"),
+    );
+    let ogg =
+        PathBuf::from(env::var("OGG_SRC").expect("OGG_SRC must point at a libogg source tree"));
+
+    println!("cargo:rerun-if-changed=tremor_shim.c");
+    println!("cargo:rerun-if-env-changed=TREMOR_SRC");
+    println!("cargo:rerun-if-env-changed=OGG_SRC");
+    println!("cargo:rerun-if-env-changed=TREMOR_COPT");
+
+    // Compiled from source instead of linked against the packaged library: the
+    // distro build is -Os with MIPS16 packing, which costs real decode time on
+    // a slow core, and its objects aren't PIC so they can't go into a PIE.
+    let tremor_srcs = [
+        "mdct.c",
+        "block.c",
+        "window.c",
+        "synthesis.c",
+        "info.c",
+        "floor1.c",
+        "floor0.c",
+        "vorbisfile.c",
+        "res012.c",
+        "mapping0.c",
+        "registry.c",
+        "codebook.c",
+        "sharedbook.c",
+    ];
+
+    // -O3 measured ~3% less decode CPU than -O2 on 24KEc, same stripped size
+    cc::Build::new()
+        .include(&tremor)
+        .include(ogg.join("include"))
+        .opt_level(
+            env::var("TREMOR_COPT")
+                .ok()
+                .and_then(|v| v.parse().ok())
+                .unwrap_or(3u32),
+        )
+        .pic(true)
+        .warnings(false)
+        .flag_if_supported("-mno-mips16")
+        .file("tremor_shim.c")
+        .files(tremor_srcs.iter().map(|f| tremor.join(f)))
+        .file(ogg.join("src/framing.c"))
+        .file(ogg.join("src/bitwise.c"))
+        .compile("tremor");
+}

diff --git a/playback/src/decoder/tremor_decoder.rs b/playback/src/decoder/tremor_decoder.rs
new file mode 100644
index 0000000..faf0e92
--- /dev/null
+++ b/playback/src/decoder/tremor_decoder.rs
@@ -0,0 +1,214 @@
+use std::{
+    io::{Read, Seek, SeekFrom},
+    os::raw::{c_int, c_long, c_void},
+};
+
+use super::{AudioDecoder, AudioPacket, AudioPacketPosition, DecoderError, DecoderResult};
+
+// ov_read hands back at most one Vorbis block. 8 KiB is 2048 samples, about
+// 23 ms of 44.1k stereo, which keeps packet sizes in the range the player was
+// already seeing from symphonia.
+const READ_BUF: usize = 8192;
+
+// A lost page is recoverable: Tremor resyncs on the next read. Give up after a
+// while so a stream that only produces holes can't spin the playback thread.
+const OV_HOLE: c_long = -3;
+const MAX_HOLES: u32 = 64;
+
+// Tremor emits full-scale i16; the player wants normalised f64.
+const SCALE: f64 = 1.0 / 32768.0;
+
+#[repr(C)]
+struct TremCtx {
+    _opaque: [u8; 0],
+}
+
+type ReadFn = extern "C" fn(*mut c_void, *mut u8, c_long) -> c_long;
+type SeekFn = extern "C" fn(*mut c_void, i64, c_int) -> c_int;
+type TellFn = extern "C" fn(*mut c_void) -> i64;
+
+unsafe extern "C" {
+    fn trem_open(user: *mut c_void, rd: ReadFn, sk: SeekFn, tl: TellFn) -> *mut TremCtx;
+    fn trem_read(ctx: *mut TremCtx, buf: *mut u8, len: c_int) -> c_long;
+    fn trem_pcm_seek(ctx: *mut TremCtx, pos: i64) -> c_int;
+    fn trem_pcm_tell(ctx: *mut TremCtx) -> i64;
+    fn trem_channels(ctx: *mut TremCtx) -> c_int;
+    fn trem_rate(ctx: *mut TremCtx) -> c_long;
+    fn trem_close(ctx: *mut TremCtx);
+}
+
+// Unwinding out of these into C is UB, so every path returns an error code.
+extern "C" fn cb_read<R: Read + Seek>(user: *mut c_void, buf: *mut u8, len: c_long) -> c_long {
+    if len <= 0 || buf.is_null() || user.is_null() {
+        return 0;
+    }
+
+    let src = unsafe { &mut *(user as *mut R) };
+    let dst = unsafe { std::slice::from_raw_parts_mut(buf, len as usize) };
+
+    // Tremor reads a short count as end of stream, but the streaming reader
+    // can legitimately hand back less than asked for, so fill the buffer.
+    let mut done = 0;
+    while done < dst.len() {
+        match src.read(&mut dst[done..]) {
+            Ok(0) => break,
+            Ok(n) => done += n,
+            Err(e) if e.kind() == std::io::ErrorKind::Interrupted => continue,
+            Err(_) => return if done > 0 { done as c_long } else { -1 },
+        }
+    }
+
+    done as c_long
+}
+
+extern "C" fn cb_seek<R: Read + Seek>(user: *mut c_void, off: i64, whence: c_int) -> c_int {
+    if user.is_null() {
+        return -1;
+    }
+
+    let src = unsafe { &mut *(user as *mut R) };
+    let target = match whence {
+        0 if off >= 0 => SeekFrom::Start(off as u64),
+        1 => SeekFrom::Current(off),
+        2 => SeekFrom::End(off),
+        _ => return -1,
+    };
+
+    match src.seek(target) {
+        Ok(_) => 0,
+        Err(_) => -1,
+    }
+}
+
+extern "C" fn cb_tell<R: Read + Seek>(user: *mut c_void) -> i64 {
+    if user.is_null() {
+        return -1;
+    }
+
+    let src = unsafe { &mut *(user as *mut R) };
+
+    match src.stream_position() {
+        Ok(pos) => pos as i64,
+        Err(_) => -1,
+    }
+}
+
+pub struct TremorDecoder<R: Read + Seek> {
+    ctx: *mut TremCtx,
+    src: *mut R,
+    channels: usize,
+    rate: u64,
+    buf: Vec<u8>,
+}
+
+// The pointers are owned by this struct and never shared.
+unsafe impl<R: Read + Seek + Send> Send for TremorDecoder<R> {}
+
+impl<R: Read + Seek> TremorDecoder<R> {
+    pub fn new(input: R) -> DecoderResult<Self> {
+        let src = Box::into_raw(Box::new(input));
+
+        let ctx = unsafe {
+            trem_open(
+                src as *mut c_void,
+                cb_read::<R>,
+                cb_seek::<R>,
+                cb_tell::<R>,
+            )
+        };
+
+        if ctx.is_null() {
+            drop(unsafe { Box::from_raw(src) });
+            return Err(DecoderError::TremorDecoder(
+                "ov_open_callbacks failed, not a Vorbis stream?".to_string(),
+            ));
+        }
+
+        let channels = unsafe { trem_channels(ctx) };
+        let rate = unsafe { trem_rate(ctx) };
+
+        if channels <= 0 || rate <= 0 {
+            unsafe { trem_close(ctx) };
+            drop(unsafe { Box::from_raw(src) });
+            return Err(DecoderError::TremorDecoder(format!(
+                "bogus stream: {channels} channels at {rate} Hz"
+            )));
+        }
+
+        Ok(Self {
+            ctx,
+            src,
+            channels: channels as usize,
+            rate: rate as u64,
+            buf: vec![0u8; READ_BUF],
+        })
+    }
+
+    fn position_ms(&self) -> u32 {
+        let pcm = unsafe { trem_pcm_tell(self.ctx) }.max(0) as u64;
+
+        (pcm * 1000 / self.rate) as u32
+    }
+}
+
+impl<R: Read + Seek> AudioDecoder for TremorDecoder<R> {
+    fn seek(&mut self, position_ms: u32) -> Result<u32, DecoderError> {
+        let pcm = (u64::from(position_ms) * self.rate / 1000) as i64;
+
+        let rc = unsafe { trem_pcm_seek(self.ctx, pcm) };
+        if rc != 0 {
+            return Err(DecoderError::TremorDecoder(format!(
+                "ov_pcm_seek to {position_ms} ms: {rc}"
+            )));
+        }
+
+        Ok(self.position_ms())
+    }
+
+    fn next_packet(&mut self) -> DecoderResult<Option<(AudioPacketPosition, AudioPacket)>> {
+        let position_ms = self.position_ms();
+
+        let mut holes = 0;
+        let read = loop {
+            let rc = unsafe { trem_read(self.ctx, self.buf.as_mut_ptr(), READ_BUF as c_int) };
+
+            match rc {
+                0 => return Ok(None),
+                OV_HOLE if holes < MAX_HOLES => {
+                    holes += 1;
+                    continue;
+                }
+                n if n < 0 => {
+                    return Err(DecoderError::TremorDecoder(format!("ov_read: {n}")));
+                }
+                n => break n as usize,
+            }
+        };
+
+        // Drop any trailing partial frame; the player expects whole frames.
+        let frame = 2 * self.channels;
+        let read = read - (read % frame);
+
+        let samples: Vec<f64> = self.buf[..read]
+            .chunks_exact(2)
+            .map(|s| f64::from(i16::from_ne_bytes([s[0], s[1]])) * SCALE)
+            .collect();
+
+        let position = AudioPacketPosition {
+            position_ms,
+            skipped: false,
+        };
+
+        Ok(Some((position, AudioPacket::Samples(samples))))
+    }
+}
+
+impl<R: Read + Seek> Drop for TremorDecoder<R> {
+    fn drop(&mut self) {
+        // ov_clear can still touch the callbacks, so tear it down first.
+        unsafe {
+            trem_close(self.ctx);
+            drop(Box::from_raw(self.src));
+        }
+    }
+}

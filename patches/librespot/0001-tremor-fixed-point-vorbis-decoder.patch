diff --git a/playback/tremor_shim.c b/playback/tremor_shim.c
new file mode 100644
index 0000000..aded8d0
--- /dev/null
+++ b/playback/tremor_shim.c
@@ -0,0 +1,133 @@
+/* Glue for Tremor (libvorbisidec), the fixed-point Vorbis decoder.
+ *
+ * Targets like the MT7628 have no FPU, so a float Vorbis decoder spends about
+ * half the core on soft-float emulation. Tremor does the same job in integer
+ * arithmetic for roughly a fifth of the cost.
+ *
+ * The API is deliberately flat: OggVorbis_File is large and its layout shifts
+ * between Tremor snapshots, so mirroring it in Rust would be an ABI trap.
+ */
+
+#include <stdlib.h>
+#include <ivorbisfile.h>
+
+typedef long      (*trem_read_fn)(void *user, unsigned char *buf, long len);
+typedef int       (*trem_seek_fn)(void *user, long long off, int whence);
+typedef long long (*trem_tell_fn)(void *user);
+
+struct trem_ctx {
+	OggVorbis_File vf;
+	void *user;
+	trem_read_fn rd;
+	trem_seek_fn sk;
+	trem_tell_fn tl;
+};
+
+/* fread semantics: return the item count, not the byte count */
+static size_t shim_read(void *ptr, size_t size, size_t nmemb, void *ds)
+{
+	struct trem_ctx *c = (struct trem_ctx *)ds;
+	long got;
+
+	if (size == 0 || nmemb == 0)
+		return 0;
+
+	got = c->rd(c->user, (unsigned char *)ptr, (long)(size * nmemb));
+	if (got <= 0)
+		return 0;
+
+	return (size_t)got / size;
+}
+
+static int shim_seek(void *ds, ogg_int64_t off, int whence)
+{
+	struct trem_ctx *c = (struct trem_ctx *)ds;
+
+	return c->sk(c->user, (long long)off, whence);
+}
+
+/* the Rust side owns the reader and drops it itself */
+static int shim_close(void *ds)
+{
+	(void)ds;
+	return 0;
+}
+
+static long shim_tell(void *ds)
+{
+	struct trem_ctx *c = (struct trem_ctx *)ds;
+
+	return (long)c->tl(c->user);
+}
+
+struct trem_ctx *trem_open(void *user, trem_read_fn rd, trem_seek_fn sk,
+			   trem_tell_fn tl)
+{
+	ov_callbacks cb;
+	struct trem_ctx *c;
+
+	if (!rd || !sk || !tl)
+		return NULL;
+
+	c = calloc(1, sizeof *c);
+	if (!c)
+		return NULL;
+
+	c->user = user;
+	c->rd = rd;
+	c->sk = sk;
+	c->tl = tl;
+
+	cb.read_func = shim_read;
+	cb.seek_func = shim_seek;
+	cb.close_func = shim_close;
+	cb.tell_func = shim_tell;
+
+	if (ov_open_callbacks(c, &c->vf, NULL, 0, cb) < 0) {
+		free(c);
+		return NULL;
+	}
+
+	return c;
+}
+
+/* 16-bit signed host-endian interleaved; <0 is an OV_* code, 0 is EOF */
+long trem_read(struct trem_ctx *c, unsigned char *buf, int len)
+{
+	int bitstream = 0;
+
+	return ov_read(&c->vf, (char *)buf, len, &bitstream);
+}
+
+int trem_pcm_seek(struct trem_ctx *c, long long pos)
+{
+	return ov_pcm_seek(&c->vf, (ogg_int64_t)pos);
+}
+
+long long trem_pcm_tell(struct trem_ctx *c)
+{
+	return (long long)ov_pcm_tell(&c->vf);
+}
+
+int trem_channels(struct trem_ctx *c)
+{
+	vorbis_info *vi = ov_info(&c->vf, -1);
+
+	return vi ? vi->channels : -1;
+}
+
+long trem_rate(struct trem_ctx *c)
+{
+	vorbis_info *vi = ov_info(&c->vf, -1);
+
+	return vi ? vi->rate : -1;
+}
+
+void trem_close(struct trem_ctx *c)
+{
+	if (!c)
+		return;
+
+	ov_clear(&c->vf);
+	free(c);
+}

Let the AirPlay volume profile through from UCI

shairport-sync's "standard" profile bends the client slider into its own
curve; "flat" is straight-through in dB, which is the only way the phone
slider, the panel buttons and librespot end up meaning the same thing on the
shared Master softvol.

--- a/files/shairport-sync.init
+++ b/files/shairport-sync.init
@@ -61,6 +61,7 @@
 		append_num "$cfg" resync_threshold "resync_threshold"
 		append_num "$cfg" log_verbosity "log_verbosity"
 		append_str "$cfg" ignore_volume_control "ignore_volume_control"
+		append_str "$cfg" volume_control_profile "volume_control_profile"
 		append_num "$cfg" volume_range_db "volume_range_db"
 		append_str "$cfg" regtype "regtype"
 		append_str "$cfg" playback_mode "playback_mode"

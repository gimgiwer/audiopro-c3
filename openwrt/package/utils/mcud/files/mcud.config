config mcud 'main'
	# Security Settings
	option auth_enabled '0'
	option allow_custom_commands '0'
	option session_ttl '604800'

	option enabled '1'
	option default_volume '25'
	# Auto-sleep timeout in minutes when running on battery:
	# 0  = Always-On (DEFAULT: Never sleep, 24/7 ready for HA, Spotify, AirPlay, AUX, BT)
	# 15 = Sleep after 15 minutes of inactivity
	# 30 = Sleep after 30 minutes of inactivity
	option auto_sleep_min '0'

	# Power off if no network uplink is available on battery in Wi-Fi mode:
	# 0 = Stay awake (wait indefinitely for Wi-Fi reconnection)
	# 1 = Power off after no_network_timeout_min of searching without network
	option sleep_on_no_network '0'
	option no_network_timeout_min '10'

	# Sleep policy for external inputs when running on battery:
	# 0 = Keep awake indefinitely while AUX or Bluetooth mode is selected
	# 1 = Count inactivity from last button press / source switch and sleep after auto_sleep_min
	option sleep_in_aux '0'
	option sleep_in_bt '0'

	# How often to remind the MCU we are alive, in seconds (0 = allow stock 19-min cutoff):
	option mcu_keepalive_sec '60'
	# Log level: 0=ERROR, 1=WARN, 2=INFO (DEFAULT), 3=DEBUG
	option log_level '2'
	option mqtt_enabled '1'
	# Broker address. Empty means MQTT stays off - there is no broker on the
	# speaker itself, so the old 127.0.0.1 default just logged an unreachable
	# network every 30 s forever. Point it at Home Assistant's, e.g.
	#   uci set mcud.main.mqtt_host='192.168.1.10'
	#   uci set mcud.main.mqtt_user='audiopro'
	#   uci set mcud.main.mqtt_password='...'   # from the Mosquitto add-on
	#   uci commit mcud && /etc/init.d/mcud restart
	option mqtt_host ''
	option mqtt_port '1883'
	option mqtt_user ''
	option mqtt_password ''
	option mqtt_topic_prefix 'audiopro_c3'
	
	# --- Audio Arbiter Settings ---
	# arbiter_policy: 
	#   mix      = No restrictions, ALSA dmix merges all streams simultaneously
	#   lifo     = Last In Wins (new stream completely stops previous ones)
	#   priority = Strict priority hierarchy, higher priority interrupts lower
	option arbiter_policy 'priority'
	
	# Priorities (Lower number = higher priority)
	option prio_snapcast '1'
	option prio_airplay '2'
	option prio_spotify '3'
	option prio_dlna '4'
	option prio_webradio '5'
	option prio_squeeze '6'

config alarm 'alarm'
	option enabled '0'
	option time '07:00'
	option days '1,2,3,4,5'
	option target_volume '60'
	option alarm_mode 'gentle'
	option sound_type 'chime'
	option sound_file '/usr/share/sounds/alarm_wake_up.wav'
	option stream_url 'http://icecast.vrtcdn.be/klara-high.mp3'
	option spotify_uri 'spotify:track:4cOdK2wGLETKBW3PvgPWqT'
	option fade_sec '0'
	option duration_min '30'
	option snooze_min '9'



#!/bin/sh /etc/rc.common

START=15
STOP=10

USE_PROCD=1
PROG=/usr/bin/mcud

start_service() {
    local enabled default_vol auto_sleep sleep_in_aux sleep_in_bt sleep_on_no_net no_net_timeout log_lvl keepalive mqtt_enabled mqtt_host mqtt_port mqtt_user mqtt_pass mqtt_prefix ma_host ma_port ma_step ma_owns

    config_load mcud
    config_get_bool enabled main enabled 1
    [ "$enabled" -eq 1 ] || return 0

    config_get default_vol main default_volume "25"
    config_get auto_sleep main auto_sleep_min "0"
    config_get_bool sleep_in_aux main sleep_in_aux 0
    config_get_bool sleep_in_bt main sleep_in_bt 0
    config_get_bool sleep_on_no_net main sleep_on_no_network 0
    config_get no_net_timeout main no_network_timeout_min "10"
    config_get log_lvl main log_level "2"
    config_get keepalive main mcu_keepalive_sec "60"
    config_get_bool mqtt_enabled main mqtt_enabled 1
    config_get mqtt_host main mqtt_host ""
    config_get mqtt_port main mqtt_port "1883"
    config_get mqtt_user main mqtt_user ""
    config_get mqtt_pass main mqtt_password ""
    [ -z "$mqtt_pass" ] && config_get mqtt_pass main mqtt_pass ""
    config_get mqtt_prefix main mqtt_topic_prefix "audiopro_c3"
    config_get ma_host main ma_host ""
    config_get ma_port main ma_port "9090"
    config_get ma_step main ma_volume_step "5"
    config_get_bool ma_owns main ma_owns_volume 0

    local args="-v $default_vol -s $auto_sleep -l $log_lvl -k $keepalive"
    [ "$sleep_in_aux" -eq 1 ] && args="$args -a"
    [ "$sleep_in_bt" -eq 1 ] && args="$args -b"
    [ "$sleep_on_no_net" -eq 1 ] && args="$args -n -N $no_net_timeout"

    # no broker host means MQTT stays off - otherwise mosquitto reconnects forever
    if [ "$mqtt_enabled" -eq 1 ] && [ -n "$mqtt_host" ]; then
        args="$args -h $mqtt_host -p $mqtt_port -t $mqtt_prefix"
        [ -n "$mqtt_user" ] && args="$args -u $mqtt_user"
        [ -n "$mqtt_pass" ] && args="$args -P $mqtt_pass"
    else
        args="$args -m"
    fi

    # Music Assistant's LMS command line. Empty falls back to the broker host,
    # or to squeezelite's server address.
    [ -z "$ma_host" ] && ma_host="$mqtt_host"
    [ -z "$ma_host" ] && ma_host="$(uci -q get squeezelite.options.server_addr)"
    local prof_mode
    prof_mode="$(uci -q get profile.main.mode)"
    if [ "$prof_mode" != "standalone" ] && [ -n "$ma_host" ]; then
        args="$args -A $ma_host -Q $ma_port -G $ma_step"
    fi
    if [ "$prof_mode" = "smarthome" ] || { [ "$prof_mode" != "standalone" ] && [ "${ma_owns:-0}" -eq 1 ]; }; then
        args="$args -o"
    fi

    procd_open_instance
    procd_set_param command "$PROG" $args
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param user root
    # renice does not exist in this busybox, so procd is the only place a
    # priority can be set at all - see the dilation table in the librespot init
    procd_set_param nice -5
    procd_close_instance
}

